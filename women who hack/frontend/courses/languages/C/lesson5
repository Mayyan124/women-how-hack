      <pre><code>#include <stdio.h>

int main() {
    int age;
    printf("הכנסי גיל: ");
    scanf("%d", &age);

    if (age < 13) {
        printf("ילדה\n");
    } else if (age < 18) {
        printf("נערה\n");
    } else if (age < 65) {
        printf("מבוגרת — ברוכה הבאה! ✓\n");
    } else {
        printf("חברה ותיקה ומוערכת!\n");
    }

    // כל מספר != 0 הוא אמת בC
    int x = 5;
    if (x) {
        printf("x שונה מ-0 — נחשב אמת!\n");
    }
    return 0;
}</code></pre>
