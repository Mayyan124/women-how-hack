<script>
  const answers={"q1": "ב", "q2": "ב", "q3": "ב", "q4": "ג", "q5": "ב"};
  function showScore(){
    let s=0;
    for(let q in answers){
      const chosen=document.querySelector('input[name="'+q+'"]:checked');
      document.querySelectorAll('input[name="'+q+'"]').forEach(o=>{
        const l=o.parentElement;
        if(o.value===answers[q]) l.classList.add('correct');
        else if(chosen&&o.value===chosen.value) l.classList.add('wrong');
        o.disabled=true;
      });
      if(chosen&&chosen.value===answers[q]) s++;
    }
    const el=document.getElementById('score');
    el.style.display='block';
    const msgs=['נסי שוב &#128170;','ממשיכות!','לא רע!','כמעט מושלם!','מושלם! &#127881;'];
    el.innerHTML='קיבלת '+s+'/5 &#10024; &mdash; '+msgs[Math.min(s,4)];
  }
  document.querySelectorAll('.lesson-nav a').forEach(a=>{
    a.addEventListener('click',function(e){
      const t=document.querySelector(this.getAttribute('href'));
      if(t&&this.getAttribute('href').startsWith('#')){
        e.preventDefault();
        document.querySelectorAll('.lesson-nav a').forEach(x=>x.classList.remove('active'));
        this.classList.add('active');
        t.scrollIntoView({behavior:'smooth'});
      }
    });
  });
</script>
