<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
import { getAuth, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";
const app = initializeApp({apiKey:"AIzaSyC-k44JqPI_wYvUwwqDsq4mdB1HAinJE4o",authDomain:"women-who-hack-40840.firebaseapp.com",projectId:"women-who-hack-40840",storageBucket:"women-who-hack-40840.firebasestorage.app",messagingSenderId:"180448551855",appId:"1:180448551855:web:5a05c8deb44fcc2f7f055a"});
const auth = getAuth(app);

const letters = [
  `יש רגעים בחיים שלא תמיד מבינים את המשמעות שלהם בזמן אמת — אבל הם נשארים איתנו הרבה אחרי. והרגע הזה, שבו סיימת את קורס C, הוא בדיוק כזה.\n\nלאורך הדרך ראיתי אותך מתמודדת עם דברים שלא תמיד היו פשוטים — מצביעים, ניהול זיכרון, Bitwise. ובכל פעם מחדש בחרת להמשיך. גם כשזה דרש ממך סבלנות, גם כשזה דרש ממך אמונה בעצמך.\n\nמי שמבינה C, מבינה איך המחשב חושב. ואת — הבנת.\n\nאני גאה בך מכל הלב 💙\nמעיין`,
  `יש משהו בדרך שלך שפשוט אי אפשר לפספס — הנחישות שלך, הרצון להבין באמת ולא רק לעבור הלאה.\n\nC היא לא שפה קלה. היא שפה שדורשת להבין את המחשב ממש מבפנים — זיכרון, כתובות, ביטים. ואת בחרת להתמודד עם כל זה עד הסוף.\n\nאת יוצאת מהקורס הזה עם משהו שרוב האנשים לא יודעים: איך המחשב באמת עובד.\n\nאני מאמינה בך באמת 💙\nמעיין`,
  `לפעמים התהליך עצמו הוא הדבר הכי חשוב — לא התוצאה הסופית, אלא הדרך שעברת.\n\nקורס C הוא אחד הדברים המאתגרים ביותר שלמדת — ניהול זיכרון ידני, מצביעים, הצפנה בינארית. וסיימת אותו.\n\nיש בך סקרנות אמיתית, רצון להבין לעומק. וזה משהו נדיר שייקח אותך רחוק.\n\nגאה בך מאוד 💙\nמעיין`,
  `יש אנשים שרואים "Segmentation Fault" ועוצרים — ויש אנשים שמחפשות למה זה קרה ומתקנות. ואת בדיוק מהסוג השני.\n\nC לימדה אותך לחשוב אחרת — לראות את הזיכרון, להבין את הכתובות, לשלוט בביטים. זה לא ידע רגיל. זו חשיבה של מהנדסת.\n\nאני רוצה שתיקחי את הביטחון הזה איתך לכל אתגר שיבוא.\n\nאני גאה בך מאוד 💙\nמעיין`,
  `כשמסתכלים אחורה על הדרך שעברת בקורס C, אפשר לראות שינוי אמיתי — לא רק בידע, אלא בגישה שלך לבעיות.\n\nבהתחלה malloc היה מפחיד, מצביעים היו מבלבלים, XOR הצפנה הרגישה כמו קסם. ועכשיו? את כותבת מסד נתונים מוצפן בקוד מאוחסן בינארי.\n\nהקורס הזה הוא הצעד הראשון בדרך הרבה יותר גדולה בעולם הסייבר.\n\nאוהבת וגאה בך 💙\nמעיין`
];

onAuthStateChanged(auth, (user) => {
  if (!user) { window.location.href = '/login'; return; }
  const name = user.displayName || user.email.split('@')[0];
  const date = new Date().toLocaleDateString('he-IL', {year:'numeric', month:'long', day:'numeric'});
  let h = 0;
  for (const c of user.uid) h = Math.imul(31, h) + c.charCodeAt(0) | 0;
  const certId = 'WWH-C-' + Math.abs(h).toString(36).toUpperCase().slice(0, 8);
  document.getElementById('letter-name').textContent = name;
  document.getElementById('letter-body').textContent = letters[Math.abs(h) % letters.length];
  document.getElementById('cert-name').textContent = name;
  document.getElementById('cert-date').textContent = date;
  document.getElementById('cert-id').textContent = certId;
  window._certData = { name, date, certId };
  document.getElementById('loading').style.display = 'none';
  document.getElementById('page').style.display = 'flex';
  setTimeout(() => document.getElementById('page').classList.add('visible'), 50);
});
</script>
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
