.letter-label{font-size:.75rem;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:rgba(200,134,74,.7)}
.letter-title{font-size:1.1rem;font-weight:900;color:#f0e6d3;margin-top:2px}
