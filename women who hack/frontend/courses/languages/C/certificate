<script>
async function downloadPDF() {
  const btn = document.getElementById('dlBtn');
  const name = document.getElementById('cert-name').textContent.trim();
  const filename = 'WWH-C-' + name.replace(/\s+/g, '-') + '.pdf';
  btn.disabled = true; btn.textContent = '⏳ מייצרת...';
  try {
    const cert = document.getElementById('cert');
    const canvas = await html2canvas(cert, {
      scale:2, useCORS:true, backgroundColor:'#FEFCF0', logging:false,
      onclone: function(doc) {
        const el = doc.getElementById('cert-name');
        if (el) { el.style.webkitTextFillColor='#6b3a1f'; el.style.color='#6b3a1f'; }
      }
    });
    const img = canvas.toDataURL('image/jpeg', 0.95);
    const { jsPDF } = window.jspdf;
    const pdf = new jsPDF({orientation:'landscape', unit:'mm', format:'a4'});
    const pw = pdf.internal.pageSize.getWidth();
    const ph = pdf.internal.pageSize.getHeight();
    const m = 8;
    const r = Math.min((pw-m*2)/canvas.width, (ph-m*2)/canvas.height);
    pdf.addImage(img, 'JPEG', (pw-canvas.width*r)/2, (ph-canvas.height*r)/2, canvas.width*r, canvas.height*r);
    pdf.save(filename);
    btn.disabled = false; btn.innerHTML = '✅ הורד!';
    setTimeout(() => { btn.innerHTML = '⬇️ הורידי את התעודה PDF'; }, 3000);
  } catch(e) {
    btn.disabled = false; btn.innerHTML = '⬇️ הורידי את התעודה PDF';
    alert('נסי: Ctrl+P ← "שמור כ-PDF"');
  }
}
</script>
