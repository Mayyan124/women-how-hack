.btn-dl{background:linear-gradient(135deg,#8b4a1a,#c8864a);color:#fff;box-shadow:0 4px 14px rgba(200,134,74,.3)}
.btn-dl:hover{box-shadow:0 8px 22px rgba(200,134,74,.45)}
.btn-print{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.2);color:rgba(240,230,211,.75)}
.btn-back{background:transparent;border:1px solid rgba(255,255,255,.15);color:rgba(240,230,211,.45);font-size:.85rem;text-decoration:none;display:inline-flex;align-items:center;gap:6px;padding:13px 20px;border-radius:50px}
.btn-back:hover{color:rgba(240,230,211,.75);border-color:rgba(255,255,255,.3)}

@media(max-width:560px){
  .cert-body{padding:28px 18px}
