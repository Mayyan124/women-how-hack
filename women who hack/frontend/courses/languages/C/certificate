.sig-name{font-family:'Frank Ruhl Libre',serif;font-size:1rem;font-weight:700;color:#1a0800}
.sig-title{font-size:.68rem;color:#aaa;letter-spacing:1px;text-transform:uppercase;margin-top:2px}
.seal{width:76px;height:76px;background:linear-gradient(135deg,#6b3a1f,#c8864a);border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:0 4px 18px rgba(107,58,31,.4);flex-shrink:0;margin:0 24px}
.seal-icon{font-size:1.5rem}
