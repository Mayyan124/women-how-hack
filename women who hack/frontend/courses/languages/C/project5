    <pre><code>#include &lt;stdio.h&gt;
#include &lt;string.h&gt;

typedef struct {
    char name[50];
    int level;
} Agent;

// פונקציית הצפנה/פענוח XOR
void xorEncrypt(char *data, char key) {
    for (int i = 0; i &lt; strlen(data); i++) {
        data[i] = data[i] ^ key;  // XOR כל תו
    }
}

int main() {
    Agent a1 = {"CyberQueen", 5};
    char key = 'K';  // מפתח סודי

    // ── שלב 1: הצפנה ושמירה ──
    xorEncrypt(a1.name, key);

    FILE *f = fopen("database.bin", "wb");
    if (f == NULL) {
        printf("כשל בפתיחת קובץ!\n");
        return 1;
    }
    fwrite(&a1, sizeof(Agent), 1, f);
    fclose(f);
    printf("הוצפן ונשמר בהצלחה!\n");

    // ── שלב 2: טעינה ופענוח ──
    Agent loaded;
    f = fopen("database.bin", "rb");
    if (f == NULL) {
        printf("כשל בטעינה!\n");
        return 1;
    }
    fread(&loaded, sizeof(Agent), 1, f);
    fclose(f);

    // XOR כפול = חזרה למקור!
    xorEncrypt(loaded.name, key);

    printf("שם: %s | רמה: %d\n", loaded.name, loaded.level);
    return 0;
}</code></pre>
