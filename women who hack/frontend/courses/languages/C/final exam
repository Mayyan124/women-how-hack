<script>
const answers = {
  q1:'B', q2:'B', q3:'B', q4:'B', q5:'B',
  q6:'B', q7:'B', q8:'B', q9:'B', q10:'B',
  q11:'B', q12:'B', q13:'B', q14:'A', q15:'B',
  q16:'B', q17:'B', q18:'B', q19:'B', q20:'B',
  q21:'B', q22:'B', q23:'B', q24:'B', q25:'B'
};

function showFinalScore() {
  let score = 0;
  for (let q in answers) {
    const chosen = document.querySelector(`input[name="${q}"]:checked`);
    document.querySelectorAll(`input[name="${q}"]`).forEach(o => {
      const lbl = o.parentElement;
      if (o.value === answers[q]) lbl.classList.add('correct');
      else if (chosen && o.value === chosen.value) lbl.classList.add('wrong');
      o.disabled = true;
    });
    if (chosen && chosen.value === answers[q]) score++;
  }

  const pct = Math.round(score / 25 * 100);
  const el = document.getElementById('finalScore');
  el.style.display = 'block';
  document.getElementById('scoreNum').textContent = `${score}/25 — ${pct}%`;

  let msg = '';
  if (pct >= 80) {
    msg = '🏆 מצוין! את זכאית לתעודת סיום!';
    document.getElementById('certLink').style.display = 'inline-block';
  } else if (pct >= 60) {
    msg = '💪 לא רע! עוד קצת ואת מגיעה לתעודה — חזרי על החומר ונסי שוב.';
  } else {
    msg = '📚 חזרי על שיעורים שלא ענית עליהם נכון ונסי שוב. את יכולה! 🎀';
  }
  document.getElementById('scoreMsg').textContent = msg;
  el.scrollIntoView({ behavior: 'smooth', block: 'center' });
}
</script>
