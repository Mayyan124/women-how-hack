<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>פרויקט Level 4 — ניהול תלמידות | Women Who Hack C++</title>
<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=Baloo+2:wght@400;600;800&display=swap" rel="stylesheet"/>
<style>
:root{--pink-bg:#fff0f5;--pink-light:#ffe4ef;--pink-mid:#ffb6d9;--pink-dark:#f072a9;--pink-deep:#d94f8a;--pink-accent:#ff8cc8;--white:#ffffff;--text-dark:#3d1a2e;--text-mid:#7a3060;--text-light:#b56090;--shadow:rgba(240,114,169,.18);--green:#2ebd78;--green-bg:#edfbf3;--green-border:#a8edcc;--red:#e05555;--red-bg:#fdeaea;--red-border:#f5b8b8;--gold:#f5a623;--gold-bg:#fff8ed}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Quicksand',sans-serif;background:var(--pink-bg);color:var(--text-dark);min-height:100vh;overflow-x:hidden}
body::before{content:'';position:fixed;top:-120px;left:-120px;width:500px;height:500px;background:radial-gradient(circle,#ffd6ec 0%,transparent 70%);z-index:0;pointer-events:none}
body::after{content:'';position:fixed;bottom:-100px;right:-100px;width:400px;height:400px;background:radial-gradient(circle,#ffcce5 0%,transparent 70%);z-index:0;pointer-events:none}
nav{position:relative;z-index:2;background:var(--white);border-bottom:1.5px solid #ffd6ec;padding:13px 24px;display:flex;align-items:center;justify-content:space-between;box-shadow:0 2px 12px var(--shadow)}
.nav-logo{font-family:'Baloo 2',cursive;font-weight:800;font-size:1rem;color:var(--pink-deep);text-decoration:none}
.nav-back{display:flex;align-items:center;gap:6px;color:var(--text-mid);text-decoration:none;font-size:.85rem;font-weight:600;padding:7px 16px;border-radius:50px;background:var(--pink-bg);border:1.5px solid var(--pink-mid);transition:background .2s}
.nav-back:hover{background:var(--pink-light)}
.nav-badge{font-size:.78rem;font-weight:700;color:var(--gold);background:var(--gold-bg);border:1.5px solid #f5c87a;padding:5px 14px;border-radius:50px}
/* hero */
.hero{position:relative;z-index:1;text-align:center;padding:42px 20px 28px}
.hero-tag{display:inline-block;background:linear-gradient(135deg,var(--gold),#f5c87a);color:#7a4800;font-size:.76rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:5px 18px;border-radius:50px;margin-bottom:14px}
.hero h1{font-family:'Baloo 2',cursive;font-size:clamp(1.7rem,5vw,2.6rem);font-weight:800;color:var(--pink-deep);line-height:1.2}
.hero p{margin-top:10px;font-size:.95rem;color:var(--text-light);font-weight:500}
/* skills bar */
.skills-bar{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-top:18px}
.skill-tag{background:var(--white);border:1.5px solid var(--pink-mid);border-radius:50px;padding:5px 14px;font-size:.78rem;font-weight:700;color:var(--pink-deep)}
.wrap{max-width:760px;margin:0 auto;padding:10px 22px 80px;position:relative;z-index:1}
.card{background:var(--white);border-radius:20px;box-shadow:0 6px 28px var(--shadow);border:1.5px solid #ffd6ec;margin-bottom:22px;overflow:hidden;animation:fadeUp .5s ease both}
@keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.card:nth-child(1){animation-delay:.05s}.card:nth-child(2){animation-delay:.12s}.card:nth-child(3){animation-delay:.19s}.card:nth-child(4){animation-delay:.26s}.card:nth-child(5){animation-delay:.33s}.card:nth-child(6){animation-delay:.40s}
.card-head{background:linear-gradient(135deg,var(--pink-dark),var(--pink-accent));padding:16px 22px;display:flex;align-items:center;gap:12px}
.card-head.gold-head{background:linear-gradient(135deg,var(--gold),#e8951a)}
.head-icon{font-size:1.3rem}
.card-head h2{font-family:'Baloo 2',cursive;font-size:1rem;font-weight:800;color:var(--white)}
.card-body{padding:20px 22px}
/* goal list */
.goal-list{list-style:none;display:flex;flex-direction:column;gap:8px}
.goal-list li{display:flex;align-items:flex-start;gap:9px;font-size:.9rem;color:var(--text-mid);font-weight:600;line-height:1.55}
.gdot{width:9px;height:9px;border-radius:50%;background:var(--gold);flex-shrink:0;margin-top:6px}
/* steps */
.steps{display:flex;flex-direction:column;gap:14px}
.step{display:flex;gap:14px;align-items:flex-start}
.step-num{min-width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--pink-dark),var(--pink-deep));color:#fff;font-family:'Baloo 2',cursive;font-size:.95rem;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 3px 10px var(--shadow)}
.step-content{flex:1}
.step-title{font-family:'Baloo 2',cursive;font-size:.95rem;font-weight:800;color:var(--pink-deep);margin-bottom:4px}
.step-desc{font-size:.85rem;color:var(--text-mid);font-weight:600;line-height:1.55}
.step-code{background:#2d1b26;border-radius:10px;padding:10px 14px;font-family:'Courier New',monospace;font-size:.78rem;color:#f8d6e8;direction:ltr;text-align:left;margin-top:8px;line-height:1.7}
/* code block */
.code-block{background:#2d1b26;border-radius:14px;padding:16px 18px;font-family:'Courier New',monospace;font-size:.82rem;line-height:1.9;color:#f8d6e8;overflow-x:auto;direction:ltr;text-align:left;margin-top:6px}
.kw{color:#ffb6d9}.fn{color:#7ee8c0}.str{color:#ffd68a}.cmt{color:#7a5070;font-style:italic}.tp{color:#b8f0c8}.vt{color:#ffd68a}
/* output box */
.output-box{background:#1a1a2e;border:1.5px solid #4a4a7a;border-radius:12px;padding:14px 18px;font-family:'Courier New',monospace;font-size:.85rem;color:#c8f0c8;direction:ltr;text-align:left;margin-top:6px;line-height:1.8}
.out-label{font-size:.72rem;font-weight:700;color:#7a7aaa;letter-spacing:.08em;text-transform:uppercase;margin-bottom:8px;font-family:'Quicksand',sans-serif;direction:rtl;text-align:right}
/* challenge */
.challenge-list{list-style:none;display:flex;flex-direction:column;gap:10px}
.challenge-item{display:flex;align-items:flex-start;gap:10px;padding:12px 14px;background:linear-gradient(135deg,#fff8ed,#fff3e0);border:1.5px solid #f5c87a;border-radius:12px;font-size:.88rem;color:var(--text-mid);font-weight:600;line-height:1.5}
.ci-icon{font-size:1.1rem;flex-shrink:0;margin-top:1px}
/* checklist */
.checklist{display:flex;flex-direction:column;gap:8px;margin-top:8px}
.check-item{display:flex;align-items:center;gap:10px;font-size:.88rem;color:var(--text-mid);font-weight:600;cursor:pointer;padding:8px 12px;border-radius:10px;transition:background .2s;user-select:none}
.check-item:hover{background:var(--pink-bg)}
.check-item input[type=checkbox]{accent-color:var(--pink-deep);width:16px;height:16px;flex-shrink:0;cursor:pointer}
.check-item.done{text-decoration:line-through;color:var(--text-light)}
/* level complete */
.level-done{background:linear-gradient(135deg,var(--gold),#e8951a);border-radius:20px;padding:24px 22px;text-align:center;margin-bottom:22px;animation:fadeUp .5s ease .45s both}
.ld-emoji{font-size:2.8rem;margin-bottom:8px}
.ld-title{font-family:'Baloo 2',cursive;font-size:1.5rem;font-weight:800;color:#fff;margin-bottom:6px}
.ld-sub{font-size:.9rem;color:rgba(255,255,255,.9);font-weight:600}
.nav-footer{max-width:760px;margin:0 auto;padding:0 22px 50px;display:flex;justify-content:space-between;align-items:center;position:relative;z-index:1;flex-wrap:wrap;gap:12px}
.btn-nav{display:flex;align-items:center;gap:7px;padding:11px 22px;border-radius:50px;font-family:'Quicksand',sans-serif;font-size:.88rem;font-weight:700;text-decoration:none;border:1.5px solid var(--pink-mid);background:var(--white);color:var(--text-mid);transition:all .2s;box-shadow:0 3px 10px var(--shadow)}
.btn-nav:hover{background:var(--pink-light)}
.btn-nav.primary{background:linear-gradient(135deg,var(--gold),#e8951a);border-color:transparent;color:#fff}
.btn-nav.primary:hover{opacity:.88}
@media(max-width:600px){.wrap{padding:10px 14px 60px}.nav-footer{padding:0 14px 40px}}
</style>
</head>
<body>
<nav>
  <a href="index.html" class="nav-logo">🩷 Women Who Hack C++</a>
  <span class="nav-badge">🏆 פרויקט Level 4</span>
  <a href="index.html" class="nav-back">← חזרה לקורס</a>
</nav>
<div class="hero">
  <div class="hero-tag">🏆 פרויקט מסכם</div>
  <h1>ניהול תלמידות עם Struct ופוינטרים</h1>
  <p>שילוב כל מה שלמדת ב-Level 4 לתוכנית אחת שלמה! 💪</p>
  <div class="skills-bar">
    <span class="skill-tag">🧠 Struct</span>
    <span class="skill-tag">📍 Pointer</span>
    <span class="skill-tag">🔵 Boolean</span>
    <span class="skill-tag">➡️ Arrow -></span>
    <span class="skill-tag">🔄 Loop</span>
  </div>
</div>
<div class="wrap">

  <div class="card">
    <div class="card-head gold-head"><span class="head-icon">🎯</span><h2>מטרות הפרויקט</h2></div>
    <div class="card-body">
      <ul class="goal-list">
        <li><span class="gdot"></span>שילוב Struct, Pointer ו-Boolean במערכת שלמה</li>
        <li><span class="gdot"></span>מעבר על רשימת תלמידות ועדכון מצב הרשמה</li>
        <li><span class="gdot"></span>שימוש בפונקציה שמקבלת פוינטר ל-Struct ומשנה אותו</li>
        <li><span class="gdot"></span>הדפסת מידע מלא על כל תלמידה בפורמט מסודר</li>
      </ul>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><span class="head-icon">📋</span><h2>שלבי הפרויקט</h2></div>
    <div class="card-body">
      <div class="steps">
        <div class="step">
          <div class="step-num">1</div>
          <div class="step-content">
            <div class="step-title">הגדרת Struct Student</div>
            <div class="step-desc">צרי Struct בשם Student עם שלושה שדות: name (string), age (int), isEnrolled (bool).</div>
            <div class="step-code"><span style="color:#ffb6d9">struct</span> <span style="color:#b8f0c8">Student</span> {
    <span style="color:#b8f0c8">string</span> name;
    <span style="color:#b8f0c8">int</span>    age;
    <span style="color:#b8f0c8">bool</span>   isEnrolled;
};</div>
          </div>
        </div>
        <div class="step">
          <div class="step-num">2</div>
          <div class="step-content">
            <div class="step-title">יצירת מערך תלמידות</div>
            <div class="step-desc">צרי מערך של 3 תלמידות עם ערכים התחלתיים. שימי לב: isEnrolled = false בהתחלה לכולן.</div>
            <div class="step-code"><span style="color:#b8f0c8">Student</span> students[3] = {
    {<span style="color:#ffd68a">"מעיין"</span>, 18, <span style="color:#ffd68a">false</span>},
    {<span style="color:#ffd68a">"דנה"</span>,   15, <span style="color:#ffd68a">false</span>},
    {<span style="color:#ffd68a">"נועה"</span>,  22, <span style="color:#ffd68a">false</span>}
};</div>
          </div>
        </div>
        <div class="step">
          <div class="step-num">3</div>
          <div class="step-content">
            <div class="step-title">פונקציית הרשמה עם פוינטר</div>
            <div class="step-desc">כתבי פונקציה enrollStudent שמקבלת פוינטר ל-Student ומשנה את isEnrolled ל-true דרך האופרטור <code style="background:#2d1b26;color:#7ee8c0;padding:1px 5px;border-radius:4px">-></code>.</div>
            <div class="step-code"><span style="color:#b8f0c8">void</span> <span style="color:#7ee8c0">enrollStudent</span>(<span style="color:#b8f0c8">Student</span>* s) {
    s-&gt;isEnrolled = <span style="color:#ffd68a">true</span>;
}</div>
          </div>
        </div>
        <div class="step">
          <div class="step-num">4</div>
          <div class="step-content">
            <div class="step-title">לולאה לרישום והדפסה</div>
            <div class="step-desc">עברי על המערך בלולאה — קראי ל-enrollStudent לכל תלמידה, ואז הדפיסי את כל הפרטים כולל מצב ההרשמה.</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><span class="head-icon">✅</span><h2>רשימת משימות — עקבי אחר ההתקדמות!</h2></div>
    <div class="card-body">
      <div class="checklist">
        <label class="check-item"><input type="checkbox" onchange="updateCheck(this)"> הגדרתי struct Student עם name, age, isEnrolled</label>
        <label class="check-item"><input type="checkbox" onchange="updateCheck(this)"> יצרתי מערך של 3 תלמידות עם isEnrolled = false</label>
        <label class="check-item"><input type="checkbox" onchange="updateCheck(this)"> כתבתי פונקציה enrollStudent שמקבלת Student* ומשתמשת ב-></label>
        <label class="check-item"><input type="checkbox" onchange="updateCheck(this)"> הפעלתי enrollStudent בלולאה על כל התלמידות</label>
        <label class="check-item"><input type="checkbox" onchange="updateCheck(this)"> הדפסתי שם, גיל ומצב הרשמה לכל תלמידה</label>
        <label class="check-item"><input type="checkbox" onchange="updateCheck(this)"> הקוד מתקמפל ורץ ללא שגיאות 🎉</label>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><span class="head-icon">💻</span><h2>פתרון מלא — לדוגמה</h2></div>
    <div class="card-body">
      <p style="font-size:.85rem;color:var(--text-light);font-weight:600;margin-bottom:10px">💡 נסי קודם לבד! פתחי רק אם תקועה.</p>
      <details style="background:var(--pink-bg);border:1.5px solid var(--pink-mid);border-radius:14px;padding:14px 16px">
        <summary style="font-family:'Baloo 2',cursive;font-weight:800;color:var(--pink-deep);cursor:pointer;font-size:.95rem">לחצי לחשיפת הפתרון 👀</summary>
        <div class="code-block" style="margin-top:12px"><span class="kw">#include</span> &lt;iostream&gt;
<span class="kw">#include</span> &lt;string&gt;
<span class="kw">using namespace</span> std;

<span class="kw">struct</span> <span class="tp">Student</span> {
    <span class="tp">string</span> name;
    <span class="tp">int</span>    age;
    <span class="tp">bool</span>   isEnrolled;
};

<span class="cmt">// פונקציה שמקבלת פוינטר ומרשמת תלמידה</span>
<span class="tp">void</span> <span class="fn">enrollStudent</span>(<span class="tp">Student</span>* s) {
    s-&gt;isEnrolled = <span class="vt">true</span>;
}

<span class="tp">int</span> <span class="fn">main</span>() {
    <span class="tp">Student</span> students[3] = {
        {<span class="str">"מעיין"</span>, 18, <span class="vt">false</span>},
        {<span class="str">"דנה"</span>,   15, <span class="vt">false</span>},
        {<span class="str">"נועה"</span>,  22, <span class="vt">false</span>}
    };

    <span class="cmt">// לולאה ראשונה — רישום כל התלמידות</span>
    <span class="kw">for</span> (<span class="tp">int</span> i = 0; i &lt; 3; i++) {
        <span class="fn">enrollStudent</span>(&amp;students[i]);
    }

    <span class="cmt">// לולאה שנייה — הדפסת מידע</span>
    <span class="kw">for</span> (<span class="tp">int</span> i = 0; i &lt; 3; i++) {
        cout &lt;&lt; students[i].name &lt;&lt; <span class="str">" | גיל: "</span> &lt;&lt; students[i].age
             &lt;&lt; <span class="str">" | "</span>
             &lt;&lt; (students[i].isEnrolled ? <span class="str">"Enrolled ✅"</span> : <span class="str">"Not Enrolled ❌"</span>)
             &lt;&lt; endl;
    }

    <span class="kw">return</span> 0;
}</div>
      </details>
      <div style="margin-top:14px">
        <div class="out-label">פלט צפוי:</div>
        <div class="output-box">מעיין | גיל: 18 | Enrolled ✅
דנה   | גיל: 15 | Enrolled ✅
נועה  | גיל: 22 | Enrolled ✅</div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><span class="head-icon">⭐</span><h2>אתגרים בונוס</h2></div>
    <div class="card-body">
      <ul class="challenge-list">
        <li class="challenge-item"><span class="ci-icon">🥈</span><strong>אתגר 1:</strong> הוסיפי שדה grade (int) ל-Student, אתחלי לכל תלמידה ציון, והדפיסי גם אותו</li>
        <li class="challenge-item"><span class="ci-icon">🥇</span><strong>אתגר 2:</strong> כתבי פונקציה checkAccess שמקבלת פוינטר ל-Student ומחזירה bool — true רק אם isEnrolled=true וגיל >= 16</li>
        <li class="challenge-item"><span class="ci-icon">🏆</span><strong>אתגר 3 (מאתגר!):</strong> כתבי פונקציה printReport שמדפיסה כמה תלמידות נרשמו מתוך הסך הכולל, ומה הגיל הממוצע</li>
      </ul>
    </div>
  </div>

  <div class="level-done">
    <div class="ld-emoji">🏆</div>
    <div class="ld-title">Level 4 הושלם!</div>
    <div class="ld-sub">פוינטרים · Struct · Boolean · Arrow Operator<br/>את מוכנה ל-Level 5 — פונקציות מתקדמות! 🚀</div>
  </div>

</div>
<div class="nav-footer">
  <a href="level4-lesson16.html" class="btn-nav">← שיעור 16 — Boolean</a>
  <a href="level5-lesson17.html" class="btn-nav primary">Level 5 — שיעור 17 ←</a>
</div>
<script>
function updateCheck(el){
  const label=el.closest('.check-item');
  label.classList.toggle('done',el.checked);
}
</script>
</body>
</html>
