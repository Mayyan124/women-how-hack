        <div class="section-label">📝 קוד התשובה המלאה</div>
        <div class="code-block"><span class="kw">#include</span> <span class="str">&lt;iostream&gt;</span>
<span class="kw">#include</span> <span class="str">&lt;string&gt;</span>
<span class="kw">using namespace</span> std;

<span class="cmt">// ========= Base Class =========</span>
<span class="kw">class</span> <span class="tp">User</span> {
<span class="kw">public</span>:
    string name;
    <span class="tp">int</span>    age;
    <span class="tp">bool</span>   isLoggedIn;

    <span class="tp">User</span>(string n, <span class="tp">int</span> a) : name(n), age(a), isLoggedIn(<span class="kw">false</span>) {}

    <span class="tp">void</span> <span class="fn">login</span>() {
        isLoggedIn = <span class="kw">true</span>;
        cout &lt;&lt; name &lt;&lt; <span class="str">" התחברה ✅"</span> &lt;&lt; endl;
    }

    <span class="kw">virtual</span> <span class="tp">void</span> <span class="fn">showRole</span>() {
        cout &lt;&lt; name &lt;&lt; <span class="str">" is a User 👤"</span> &lt;&lt; endl;
    }
};

<span class="cmt">// ======== Derived Class ========</span>
<span class="kw">class</span> <span class="tp">Admin</span> : <span class="kw">public</span> <span class="tp">User</span> {
<span class="kw">public</span>:
    <span class="tp">Admin</span>(string n, <span class="tp">int</span> a) : <span class="tp">User</span>(n, a) {}

    <span class="tp">void</span> <span class="fn">showRole</span>() <span class="kw">override</span> {
        cout &lt;&lt; name &lt;&lt; <span class="str">" is an Admin 👑"</span> &lt;&lt; endl;
    }

    <span class="tp">void</span> <span class="fn">showPrivileges</span>() {
        cout &lt;&lt; name &lt;&lt; <span class="str">" has full privileges 🔓"</span> &lt;&lt; endl;
    }
};

<span class="cmt">// =========== main ==============</span>
<span class="tp">int</span> <span class="fn">main</span>() {
    <span class="tp">User</span>  u1(<span class="str">"Maayan"</span>, 18);
    <span class="tp">Admin</span> a1(<span class="str">"Dana"</span>,   22);

    <span class="cmt">// מערך מצביעים — פולימורפיזם!</span>
    <span class="tp">User</span>* users[2] = { &amp;u1, &amp;a1 };

    <span class="kw">for</span> (<span class="tp">int</span> i = 0; i &lt; 2; i++) {
        users[i]-&gt;<span class="fn">showRole</span>(); <span class="cmt">// virtual → הנכונה תופעל</span>
    }

    a1.<span class="fn">showPrivileges</span>();

    cout &lt;&lt; <span class="str">"----------------------------"</span> &lt;&lt; endl;
    cout &lt;&lt; <span class="str">"סה\"כ משתמשות: 2"</span> &lt;&lt; endl;

    <span class="kw">return</span> 0;
}</div>

