.head-icon{font-size:1.3rem}
.card-head h2{font-family:'Baloo 2',cursive;font-size:1rem;font-weight:800;color:var(--white)}
.card-head.gold-head h2{color:#4a3000}
.card-body{padding:20px 22px}
.goal-list{list-style:none;display:flex;flex-direction:column;gap:8px}
.goal-list li{display:flex;align-items:flex-start;gap:9px;font-size:.9rem;color:var(--text-mid);font-weight:600;line-height:1.55}
.gdot{width:9px;height:9px;border-radius:50%;background:var(--pink-dark);flex-shrink:0;margin-top:6px}
.gdot.gold{background:var(--gold)}
.steps-list{display:flex;flex-direction:column;gap:14px}
.step{display:flex;align-items:flex-start;gap:14px}
.step-num{min-width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--pink-dark),var(--pink-deep));color:var(--white);font-family:'Baloo 2',cursive;font-size:.9rem;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px}
.step-body{flex:1}
.step-title{font-family:'Baloo 2',cursive;font-size:.92rem;font-weight:800;color:var(--pink-deep);margin-bottom:4px}
.step-desc{font-size:.84rem;color:var(--text-mid);font-weight:600;line-height:1.55}
.step-code{font-family:'Courier New',monospace;font-size:.76rem;background:var(--pink-bg);border:1px solid var(--pink-mid);padding:4px 8px;border-radius:6px;display:inline-block;margin-top:4px;color:var(--pink-deep)}
.code-block{background:#2d1b26;border-radius:14px;padding:16px 18px;font-family:'Courier New',monospace;font-size:.82rem;line-height:1.9;color:#f8d6e8;overflow-x:auto;direction:ltr;text-align:left;margin-top:6px}
.kw{color:#ffb6d9}.fn{color:#7ee8c0}.str{color:#ffd68a}.cmt{color:#7a5070;font-style:italic}.tp{color:#b8f0c8}
.output-box{background:#1a1a2e;border-radius:12px;padding:14px 16px;font-family:'Courier New',monospace;font-size:.83rem;color:#a8f0c8;direction:ltr;text-align:left;margin-top:6px;line-height:1.8}
.section-label{font-family:'Baloo 2',cursive;font-size:.82rem;font-weight:800;color:var(--pink-deep);text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px}
.tips-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.tip-box{background:var(--gold-bg);border:1.5px solid var(--gold-border);border-radius:14px;padding:12px 14px}
.tip-icon{font-size:1.1rem;margin-bottom:4px}
.tip-title{font-family:'Baloo 2',cursive;font-size:.88rem;font-weight:800;color:#7a5000;margin-bottom:4px}
.tip-desc{font-size:.8rem;color:#5a3800;font-weight:600;line-height:1.5}
.completion-banner{background:linear-gradient(135deg,var(--gold-bg),#fff5d0);border:2px solid var(--gold-border);border-radius:20px;padding:28px 22px;text-align:center;margin-bottom:22px;animation:fadeUp .5s ease .7s both}
.cb-icon{font-size:3rem;margin-bottom:10px}
.cb-title{font-family:'Baloo 2',cursive;font-size:1.4rem;font-weight:800;color:#7a5000;margin-bottom:8px}
.cb-text{font-size:.9rem;color:#5a3800;font-weight:600;line-height:1.65}
.nav-footer{max-width:760px;margin:0 auto;padding:0 22px 50px;display:flex;justify-content:space-between;align-items:center;position:relative;z-index:1;flex-wrap:wrap;gap:12px}
.btn-nav{display:flex;align-items:center;gap:7px;padding:11px 22px;border-radius:50px;font-family:'Quicksand',sans-serif;font-size:.88rem;font-weight:700;text-decoration:none;border:1.5px solid var(--pink-mid);background:var(--white);color:var(--text-mid);transition:all .2s;box-shadow:0 3px 10px var(--shadow)}
.btn-nav:hover{background:var(--pink-light)}
