<script>
const correct={q1:'B',q2:'C',q3:'B'};
const answered={};
const total=Object.keys(correct).length;
function answer(qId,chosen,correctAns){
  if(answered[qId])return;
  answered[qId]=chosen;
  const block=document.getElementById(qId);
  block.querySelectorAll('.opt').forEach((o,i)=>{
    const l=['A','B','C'][i];
    o.classList.add('locked');
    if(l===correctAns)o.classList.add('correct');
    else if(l===chosen&&chosen!==correctAns)o.classList.add('wrong');
  });
  document.getElementById(qId+(chosen===correctAns?'-ok':'-no')).classList.add('show');
  if(Object.keys(answered).length===total){
    let score=Object.keys(answered).filter(q=>answered[q]===correct[q]).length;
    document.getElementById('score-num').textContent=score+' / '+total;
    document.getElementById('score-msg').textContent=['נסי שוב! 💪','כמעט! עוד קצת 🌸','יפה מאוד! 💕','מושלם! את מוכנה לפרויקט! 🎉'][score];
    document.getElementById('score-box').classList.add('show');
  }
}
</script>
