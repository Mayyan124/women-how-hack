<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>תעודת סיום | Women Who Hack C++</title>
<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;600;700&family=Baloo+2:wght@400;600;800&family=Playfair+Display:ital,wght@0,700;1,700&display=swap" rel="stylesheet"/>
<style>
:root{
  --cream:#fdf6f0;
  --rose:#d94f8a;
  --rose-light:#f9d0e4;
  --rose-mid:#f072a9;
  --gold:#c8860a;
  --gold-light:#f5d98b;
  --gold-mid:#e8b84b;
  --deep:#2d1040;
  --ink:#3d1a2e;
  --shadow-rose:rgba(217,79,138,.15);
  --shadow-gold:rgba(200,134,10,.18);
}
*{box-sizing:border-box;margin:0;padding:0}

/* ── page shell ── */
body{
  font-family:'Quicksand',sans-serif;
  background:var(--cream);
  min-height:100vh;
  display:flex;
  flex-direction:column;
  align-items:center;
  padding:30px 16px 60px;
  overflow-x:hidden;
}

/* ambient blobs */
body::before{content:'';position:fixed;top:-140px;right:-120px;width:520px;height:520px;background:radial-gradient(circle,#fce8f3 0%,transparent 65%);z-index:0;pointer-events:none}
body::after{content:'';position:fixed;bottom:-120px;left:-100px;width:420px;height:420px;background:radial-gradient(circle,#fff8e1 0%,transparent 65%);z-index:0;pointer-events:none}

/* ── top bar ── */
.topbar{width:100%;max-width:820px;display:flex;justify-content:space-between;align-items:center;margin-bottom:28px;position:relative;z-index:2}
.logo{font-family:'Baloo 2',cursive;font-weight:800;font-size:.95rem;color:var(--rose);text-decoration:none}
.back-btn{display:flex;align-items:center;gap:6px;color:var(--ink);text-decoration:none;font-size:.82rem;font-weight:700;padding:7px 16px;border-radius:50px;background:#fff;border:1.5px solid var(--rose-light);box-shadow:0 2px 8px var(--shadow-rose);transition:background .2s}
.back-btn:hover{background:var(--rose-light)}

/* ── certificate card ── */
.cert-wrap{
  position:relative;z-index:1;
  width:100%;max-width:780px;
  background:#fff;
  border-radius:28px;
  box-shadow:0 12px 56px var(--shadow-rose), 0 4px 20px var(--shadow-gold);
  overflow:hidden;
  animation:popIn .7s cubic-bezier(.23,1.2,.46,1) both;
}
@keyframes popIn{from{opacity:0;transform:scale(.88) translateY(24px)}to{opacity:1;transform:scale(1) translateY(0)}}

/* top gold band */
.cert-band-top{
  background:linear-gradient(135deg,#e8b84b,#c8860a,#f5d98b,#c8860a);
  padding:5px 0;
  background-size:300% 100%;
  animation:shimmer 4s ease infinite;
}
@keyframes shimmer{0%,100%{background-position:0%}50%{background-position:100%}}

/* header area */
.cert-header{
  background:linear-gradient(160deg,#2d1040 0%,#4a1060 60%,#6b1a80 100%);
  padding:32px 40px 28px;
  text-align:center;
  position:relative;
  overflow:hidden;
}
.cert-header::before{
  content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse at 50% 120%,rgba(240,114,169,.25) 0%,transparent 60%);
}
.cert-org{font-family:'Baloo 2',cursive;font-size:.82rem;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--gold-light);opacity:.85;margin-bottom:10px;position:relative}
.cert-main-title{font-family:'Playfair Display',serif;font-size:clamp(1.6rem,5vw,2.4rem);font-weight:700;font-style:italic;color:#fff;line-height:1.2;position:relative;text-shadow:0 2px 12px rgba(0,0,0,.3)}
.cert-subtitle{font-family:'Baloo 2',cursive;font-size:.78rem;font-weight:600;color:var(--gold-light);letter-spacing:.12em;text-transform:uppercase;margin-top:8px;opacity:.8;position:relative}

/* star row */
.star-row{display:flex;justify-content:center;gap:6px;padding:14px 0 0;position:relative}
.star{font-size:1rem;color:var(--gold-mid);animation:starPop .4s ease both}
.star:nth-child(1){animation-delay:.1s}.star:nth-child(2){animation-delay:.2s}.star:nth-child(3){animation-delay:.3s}.star:nth-child(4){animation-delay:.4s}.star:nth-child(5){animation-delay:.5s}
@keyframes starPop{from{opacity:0;transform:scale(0)}to{opacity:1;transform:scale(1)}}

/* body */
.cert-body{padding:36px 44px 30px;text-align:center;position:relative}

/* decorative corner roses */
.cert-body::before,.cert-body::after{
  content:'🌸';
  position:absolute;
  font-size:2rem;
  opacity:.18;
}
.cert-body::before{top:14px;right:20px}
.cert-body::after{top:14px;left:20px}

.presented-to{font-family:'Quicksand',sans-serif;font-size:.88rem;font-weight:700;color:#9a6090;letter-spacing:.08em;text-transform:uppercase;margin-bottom:12px}

/* name plate */
.name-plate{
  display:inline-block;
  position:relative;
  padding:14px 40px;
  margin-bottom:18px;
}
.name-plate::before,.name-plate::after{
  content:'';position:absolute;top:50%;left:0;right:0;
  height:1.5px;background:linear-gradient(90deg,transparent,var(--gold-mid),transparent);
}
.name-plate::before{top:0}
.name-plate::after{top:100%;margin-top:-1.5px}
.student-name{
  font-family:'Playfair Display',serif;
  font-size:clamp(2rem,6vw,3.2rem);
  font-weight:700;
  color:var(--rose);
  line-height:1.15;
  text-shadow:0 2px 10px var(--shadow-rose);
}

.cert-desc{font-size:.92rem;font-weight:600;color:#6a3060;line-height:1.7;max-width:520px;margin:0 auto 22px}
.cert-desc strong{color:var(--deep)}

/* score badge */
.score-badge{
  display:inline-flex;align-items:center;gap:10px;
  background:linear-gradient(135deg,var(--rose-light),#fff0f8);
  border:2px solid var(--rose-mid);
  border-radius:50px;
  padding:10px 24px;
  margin-bottom:26px;
}
.score-badge-icon{font-size:1.3rem}
.score-badge-text{font-family:'Baloo 2',cursive;font-size:.95rem;font-weight:800;color:var(--rose)}

/* skills list */
.skills-wrap{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin-bottom:28px}
.skill-tag{background:#fdf0f8;border:1.5px solid var(--rose-light);border-radius:50px;padding:5px 14px;font-size:.78rem;font-weight:700;color:#9a3070}

/* divider */
.gold-divider{display:flex;align-items:center;gap:10px;margin:0 0 24px}
.gold-divider::before,.gold-divider::after{content:'';flex:1;height:1px;background:linear-gradient(90deg,transparent,var(--gold-mid),transparent)}
.gold-divider-icon{font-size:1rem;color:var(--gold)}

/* footer */
.cert-footer{
  display:grid;
  grid-template-columns:1fr auto 1fr;
  align-items:end;
  gap:16px;
  padding:0 20px 6px;
}
.sig-block{text-align:center}
.sig-line{height:1.5px;background:linear-gradient(90deg,transparent,#c8a0d0,transparent);margin-bottom:6px}
.sig-name{font-family:'Playfair Display',serif;font-size:.9rem;font-weight:700;font-style:italic;color:var(--deep)}
.sig-role{font-size:.72rem;font-weight:600;color:#9a6090;letter-spacing:.06em;text-transform:uppercase}
.seal{width:64px;height:64px;background:linear-gradient(135deg,var(--gold),#c8860a);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.6rem;box-shadow:0 4px 16px var(--shadow-gold);animation:sealSpin .6s ease .5s both}
@keyframes sealSpin{from{opacity:0;transform:scale(0) rotate(-180deg)}to{opacity:1;transform:scale(1) rotate(0)}}

/* date */
.cert-date{font-size:.74rem;font-weight:600;color:#b090b0;margin-top:18px;letter-spacing:.06em}

/* bottom band */
.cert-band-bot{
  background:linear-gradient(135deg,#c8860a,#e8b84b,#c8860a);
  padding:4px 0;
}

/* ── action bar ── */
.actions{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;margin-top:26px;position:relative;z-index:1}
.act-btn{display:flex;align-items:center;gap:8px;padding:12px 26px;border-radius:50px;font-family:'Quicksand',sans-serif;font-size:.88rem;font-weight:700;border:none;cursor:pointer;transition:all .2s;text-decoration:none}
.act-print{background:linear-gradient(135deg,var(--rose-mid),var(--rose));color:#fff;box-shadow:0 4px 14px var(--shadow-rose)}
.act-print:hover{opacity:.88;transform:translateY(-1px)}
.act-back{background:#fff;border:2px solid var(--rose-light);color:var(--ink);box-shadow:0 2px 10px var(--shadow-rose)}
.act-back:hover{background:var(--rose-light)}

/* print mode */
@media print{
  body{padding:0;background:#fff}
  .topbar,.actions,.cert-band-top,.cert-band-bot{display:none}
  .cert-wrap{box-shadow:none;border-radius:0;max-width:100%;animation:none}
  body::before,body::after{display:none}
}

@media(max-width:560px){
  .cert-body{padding:28px 22px 22px}
  .cert-header{padding:24px 20px 20px}
  .cert-footer{grid-template-columns:1fr;justify-items:center;gap:12px}
  .seal{order:-1}
}
</style>
</head>
<body>

<div class="topbar">
  <a href="index.html" class="logo">🩷 Women Who Hack C++</a>
  <a href="level10-finalexam.html" class="back-btn">← חזרה למבחן</a>
</div>

<div class="cert-wrap" id="cert">

  <div class="cert-band-top"></div>

  <div class="cert-header">
    <div class="cert-org">Women Who Hack C++</div>
    <div class="cert-main-title">Certificate of Completion</div>
    <div class="cert-subtitle">תעודת סיום קורס</div>
    <div class="star-row">
      <span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span>
    </div>
  </div>

  <div class="cert-body">
    <div class="presented-to">מוענקת בגאווה ל</div>

    <div class="name-plate">
      <div class="student-name" id="cert-name">שמך כאן</div>
    </div>

    <div class="cert-desc">
      על השלמת בהצלחה את <strong>קורס C++ המלא</strong> — 40 שיעורים,
      10 רמות, ופרויקט סיום מקצועי. <br/>
      הקורס כלל תכנות מבני, OOP, ירושה, פולימורפיזם,<br/>
      Templates, קבצים ועוד.
    </div>

    <div class="score-badge">
      <span class="score-badge-icon">🏆</span>
      <span class="score-badge-text" id="cert-score">ציון: 20 / 20 · 100%</span>
    </div>

    <div class="skills-wrap" id="skills-wrap">
      <span class="skill-tag">Variables & Types</span>
      <span class="skill-tag">Loops & Conditions</span>
      <span class="skill-tag">Functions & Arrays</span>
      <span class="skill-tag">File I/O</span>
      <span class="skill-tag">OOP & Classes</span>
      <span class="skill-tag">Inheritance</span>
      <span class="skill-tag">Polymorphism</span>
      <span class="skill-tag">Templates</span>
      <span class="skill-tag">Static Variables</span>
      <span class="skill-tag">Project Design</span>
    </div>

    <div class="gold-divider">
      <div class="gold-divider-icon">✦</div>
    </div>

    <div class="cert-footer">
      <div class="sig-block">
        <div class="sig-line"></div>
        <div class="sig-name">Women Who Hack</div>
        <div class="sig-role">מייסדת הקורס</div>
      </div>

      <div class="seal">🌸</div>

      <div class="sig-block">
        <div class="sig-line"></div>
        <div class="sig-name" id="cert-name-sig">—</div>
        <div class="sig-role">חתימת הבוגרת</div>
      </div>
    </div>

    <div class="cert-date" id="cert-date">תאריך: —</div>

  </div>

  <div class="cert-band-bot"></div>

</div>

<div class="actions">
  <button class="act-btn act-print" onclick="window.print()">🖨️ הדפיסי / שמרי כ-PDF</button>
  <a href="level10-finalexam.html" class="act-btn act-back">← חזרה למבחן</a>
</div>

<script>
// ── Read URL params ──
const params = new URLSearchParams(window.location.search);
const name  = params.get('name')  || 'הבוגרת שלנו';
const score = params.get('score') || '—';
const pct   = params.get('pct')   || '—';

// ── Populate certificate ──
document.getElementById('cert-name').textContent     = name;
document.getElementById('cert-name-sig').textContent = name;
document.getElementById('cert-score').textContent    = `ציון: ${score} / 20 · ${pct}`;

// ── Date ──
const now   = new Date();
const months= ['ינואר','פברואר','מרץ','אפריל','מאי','יוני','יולי','אוגוסט','ספטמבר','אוקטובר','נובמבר','דצמבר'];
const dateStr = `${now.getDate()} ב${months[now.getMonth()]} ${now.getFullYear()}`;
document.getElementById('cert-date').textContent = 'תאריך: ' + dateStr;

// ── Dynamic title ──
document.title = `תעודת סיום — ${name} | Women Who Hack C++`;

// ── Confetti burst (lightweight) ──
function confetti(){
  const emojis=['🌸','✨','💕','🎊','⭐','💖','🩷'];
  for(let i=0;i<22;i++){
    const el=document.createElement('div');
    el.textContent=emojis[Math.floor(Math.random()*emojis.length)];
    el.style.cssText=`position:fixed;top:-20px;left:${Math.random()*100}vw;font-size:${1+Math.random()*1.2}rem;pointer-events:none;z-index:999;animation:fall ${1.8+Math.random()*2}s ease forwards`;
    document.body.appendChild(el);
    setTimeout(()=>el.remove(), 4200);
  }
}
const style=document.createElement('style');
style.textContent='@keyframes fall{to{transform:translateY(110vh) rotate(540deg);opacity:0}}';
document.head.appendChild(style);
setTimeout(confetti, 500);
setTimeout(confetti, 1600);
</script>
</body>
</html>
