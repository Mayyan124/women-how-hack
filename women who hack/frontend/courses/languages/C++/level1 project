  <!-- דרישות הפרויקט -->
  <div class="card">
    <div class="card-head"><span class="head-icon">📋</span><h2>דרישות הפרויקט</h2></div>
    <div class="card-body">
      <ol class="req-list">
        <li class="req-item"><div class="req-num">1</div><div class="req-text">בקשי מהמשתמשת <strong>שם</strong> (string) ושמרי במשתנה</div></li>
        <li class="req-item"><div class="req-num">2</div><div class="req-text">בקשי <strong>גיל</strong> (int) ושמרי במשתנה</div></li>
        <li class="req-item"><div class="req-num">3</div><div class="req-text">בקשי <strong>עיר מגורים</strong> (string) ושמרי במשתנה</div></li>
        <li class="req-item"><div class="req-num">4</div><div class="req-text">בקשי האם אוהבת קפה — <strong>1 לכן / 0 לאו</strong> (bool) ושמרי</div></li>
        <li class="req-item"><div class="req-num">5</div><div class="req-text">הדפיסי <strong>כרטיס הצגה</strong> מסודר עם כל הפרטים</div></li>
