<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>פרויקט — הצגת עצמי | Women Who Hack C++</title>
<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=Baloo+2:wght@400;600;800&display=swap" rel="stylesheet"/>
<style>
:root{--pink-bg:#fff0f5;--pink-light:#ffe4ef;--pink-mid:#ffb6d9;--pink-dark:#f072a9;--pink-deep:#d94f8a;--pink-accent:#ff8cc8;--white:#ffffff;--text-dark:#3d1a2e;--text-mid:#7a3060;--text-light:#b56090;--shadow:rgba(240,114,169,.18);--green:#2ebd78;--green-bg:#edfbf3;--green-border:#a8edcc;--gold:#f5b942;--gold-bg:#fffbea;--gold-border:#f5d87a}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Quicksand',sans-serif;background:var(--pink-bg);color:var(--text-dark);min-height:100vh;overflow-x:hidden}
body::before{content:'';position:fixed;top:-120px;left:-120px;width:500px;height:500px;background:radial-gradient(circle,#ffd6ec 0%,transparent 70%);z-index:0;pointer-events:none}
body::after{content:'';position:fixed;bottom:-100px;right:-100px;width:400px;height:400px;background:radial-gradient(circle,#ffcce5 0%,transparent 70%);z-index:0;pointer-events:none}
nav{position:relative;z-index:2;background:var(--white);border-bottom:1.5px solid #ffd6ec;padding:13px 24px;display:flex;align-items:center;justify-content:space-between;box-shadow:0 2px 12px var(--shadow)}
.nav-logo{font-family:'Baloo 2',cursive;font-weight:800;font-size:1rem;color:var(--pink-deep);text-decoration:none}
.nav-back{display:flex;align-items:center;gap:6px;color:var(--text-mid);text-decoration:none;font-size:.85rem;font-weight:600;padding:7px 16px;border-radius:50px;background:var(--pink-bg);border:1.5px solid var(--pink-mid);transition:background .2s}
.nav-back:hover{background:var(--pink-light)}
.nav-badge{font-size:.78rem;font-weight:700;color:var(--pink-deep);background:var(--pink-light);border:1.5px solid var(--pink-mid);padding:5px 14px;border-radius:50px}

/* hero - gold style for project */
.hero{position:relative;z-index:1;text-align:center;padding:42px 20px 28px}
.hero-tag{display:inline-block;background:var(--gold);color:#7a4800;font-size:.76rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:5px 18px;border-radius:50px;margin-bottom:14px}
.hero h1{font-family:'Baloo 2',cursive;font-size:clamp(1.7rem,5vw,2.6rem);font-weight:800;color:var(--pink-deep);line-height:1.2}
.hero p{margin-top:10px;font-size:.95rem;color:var(--text-light);font-weight:500}
.hero-stars{font-size:1.3rem;margin-top:10px;letter-spacing:4px;animation:fadeUp .8s ease both}

.wrap{max-width:760px;margin:0 auto;padding:10px 22px 80px;position:relative;z-index:1}
.card{background:var(--white);border-radius:20px;box-shadow:0 6px 28px var(--shadow);border:1.5px solid #ffd6ec;margin-bottom:22px;overflow:hidden;animation:fadeUp .5s ease both}
@keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.card:nth-child(1){animation-delay:.05s}.card:nth-child(2){animation-delay:.12s}.card:nth-child(3){animation-delay:.19s}.card:nth-child(4){animation-delay:.26s}.card:nth-child(5){animation-delay:.33s}.card:nth-child(6){animation-delay:.40s}

.card-head{background:linear-gradient(135deg,var(--pink-dark),var(--pink-accent));padding:16px 22px;display:flex;align-items:center;gap:12px}
.card-head.gold-head{background:linear-gradient(135deg,#e8884a,#f5b942)}
.head-icon{font-size:1.3rem}
.card-head h2{font-family:'Baloo 2',cursive;font-size:1rem;font-weight:800;color:var(--white)}
.card-body{padding:20px 22px}

.goal-list{list-style:none;display:flex;flex-direction:column;gap:8px}
.goal-list li{display:flex;align-items:flex-start;gap:9px;font-size:.9rem;color:var(--text-mid);font-weight:600;line-height:1.55}
.gdot{width:9px;height:9px;border-radius:50%;background:var(--pink-dark);flex-shrink:0;margin-top:6px}

/* requirements */
.req-list{list-style:none;display:flex;flex-direction:column;gap:10px;counter-reset:req}
.req-item{counter-increment:req;display:flex;align-items:flex-start;gap:12px;padding:12px 14px;border-radius:14px;background:var(--pink-bg);border:1.5px solid #ffd6ec}
.req-num{min-width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,var(--pink-dark),var(--pink-deep));color:var(--white);font-weight:800;font-size:.78rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px}
.req-text{font-size:.9rem;color:var(--text-mid);font-weight:600;line-height:1.55}
.req-text strong{color:var(--pink-deep)}

/* bonus */
.bonus-box{background:linear-gradient(135deg,var(--gold-bg),#fffef0);border:2px solid var(--gold-border);border-radius:14px;padding:14px 16px}
.bonus-title{font-family:'Baloo 2',cursive;font-size:.9rem;font-weight:800;color:#8a5a00;margin-bottom:10px}
.bonus-list{list-style:none;display:flex;flex-direction:column;gap:7px}
.bonus-list li{display:flex;align-items:flex-start;gap:9px;font-size:.88rem;color:#7a5000;font-weight:600;line-height:1.5}
.bdot{color:var(--gold);font-size:1rem;flex-shrink:0}

/* expected output */
.output-box{background:#1a1a2e;border-radius:14px;padding:16px 18px;font-family:'Courier New',monospace;font-size:.84rem;line-height:2;color:#e8e8f0;direction:ltr;text-align:left}
.out-prompt{color:#ffb6d9}.out-input{color:#7ee8c0}.out-text{color:#f8d6e8}.out-special{color:#ffd68a}

/* solution - hidden by default */
.solution-toggle{width:100%;background:linear-gradient(135deg,var(--pink-dark),var(--pink-deep));color:var(--white);border:none;border-radius:14px;padding:14px 20px;font-family:'Quicksand',sans-serif;font-size:.92rem;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:10px;transition:opacity .2s;margin-bottom:0}
.solution-toggle:hover{opacity:.88}
.solution-toggle .toggle-icon{font-size:1.1rem;transition:transform .3s}
.solution-toggle.open .toggle-icon{transform:rotate(180deg)}
.solution-body{display:none;padding-top:16px}
.solution-body.show{display:block}
.code-block{background:#2d1b26;border-radius:14px;padding:16px 18px;font-family:'Courier New',monospace;font-size:.82rem;line-height:1.9;color:#f8d6e8;overflow-x:auto;direction:ltr;text-align:left}
.kw{color:#ffb6d9}.fn{color:#7ee8c0}.str{color:#ffd68a}.cmt{color:#7a5070;font-style:italic}.tp{color:#b8f0c8}
.section-label{font-family:'Baloo 2',cursive;font-size:.82rem;font-weight:800;color:var(--pink-deep);text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px;margin-top:16px}
.section-label:first-child{margin-top:0}
.explain-list{list-style:none;display:flex;flex-direction:column;gap:8px;margin-top:6px}
.explain-list li{display:flex;align-items:flex-start;gap:10px;font-size:.88rem;color:var(--text-mid);font-weight:600;line-height:1.55}
.explain-list li .edot{color:var(--pink-dark);font-size:1rem;flex-shrink:0}

/* checklist */
.checklist{list-style:none;display:flex;flex-direction:column;gap:8px}
.check-item{display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:12px;background:var(--green-bg);border:1.5px solid var(--green-border);font-size:.88rem;font-weight:600;color:#1a5c38;cursor:pointer;user-select:none;transition:opacity .2s}
.check-item.unchecked{background:var(--pink-bg);border-color:#ffd6ec;color:var(--text-mid)}
.check-item .chk{width:22px;height:22px;border-radius:6px;border:2px solid var(--green-border);background:var(--green);color:white;display:flex;align-items:center;justify-content:center;font-size:.75rem;flex-shrink:0;transition:all .2s}
.check-item.unchecked .chk{background:var(--white);border-color:var(--pink-mid);color:transparent}

/* complete card */
.complete-card{background:linear-gradient(135deg,var(--pink-deep),#c0397a);border-radius:20px;padding:28px;text-align:center;animation:fadeUp .5s ease .45s both;box-shadow:0 10px 40px rgba(217,79,138,.35)}
.complete-card .cc-icon{font-size:3rem;margin-bottom:10px}
.complete-card h2{font-family:'Baloo 2',cursive;font-size:1.4rem;font-weight:800;color:var(--white);margin-bottom:8px}
.complete-card p{font-size:.9rem;color:rgba(255,255,255,.88);font-weight:600;line-height:1.6;max-width:480px;margin:0 auto 18px}
.badge-row{display:flex;justify-content:center;gap:12px;flex-wrap:wrap}
.badge{background:rgba(255,255,255,.2);color:var(--white);border:1.5px solid rgba(255,255,255,.4);border-radius:50px;padding:7px 18px;font-size:.82rem;font-weight:700;backdrop-filter:blur(4px)}

.nav-footer{max-width:760px;margin:0 auto;padding:0 22px 50px;display:flex;justify-content:space-between;align-items:center;position:relative;z-index:1;flex-wrap:wrap;gap:12px}
.btn-nav{display:flex;align-items:center;gap:7px;padding:11px 22px;border-radius:50px;font-family:'Quicksand',sans-serif;font-size:.88rem;font-weight:700;text-decoration:none;border:1.5px solid var(--pink-mid);background:var(--white);color:var(--text-mid);transition:all .2s;box-shadow:0 3px 10px var(--shadow)}
.btn-nav:hover{background:var(--pink-light)}
.btn-nav.primary{background:linear-gradient(135deg,var(--pink-dark),var(--pink-deep));border-color:transparent;color:var(--white)}
.btn-nav.primary:hover{opacity:.88}
@media(max-width:600px){.wrap{padding:10px 14px 60px}.nav-footer{padding:0 14px 40px}}
</style>
</head>
