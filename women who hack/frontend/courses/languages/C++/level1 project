        <span class="toggle-icon">▼</span>
      </button>
      <div class="solution-body" id="solution-body">

        <div class="section-label">📝 קוד התשובה המלאה</div>
        <div class="code-block"><span class="kw">#include</span> &lt;iostream&gt;
<span class="kw">using namespace</span> std;

<span class="kw">int</span> <span class="fn">main</span>() {

    <span class="cmt">// --- הכרזת משתנים ---</span>
    <span class="tp">string</span> name;
    <span class="tp">int</span>    age;
    <span class="tp">string</span> city;
    <span class="tp">bool</span>   loveCoffee;

    <span class="cmt">// --- קלט מהמשתמשת ---</span>
    cout &lt;&lt; <span class="str">"מה שמך? "</span>;
    cin  &gt;&gt; name;

    cout &lt;&lt; <span class="str">"מה גילך? "</span>;
    cin  &gt;&gt; age;

    cout &lt;&lt; <span class="str">"באיזו עיר את גרה? "</span>;
    cin  &gt;&gt; city;

    cout &lt;&lt; <span class="str">"את אוהבת קפה? (1=כן, 0=לא): "</span>;
    cin  &gt;&gt; loveCoffee;

    <span class="cmt">// --- הדפסת כרטיס הצגה ---</span>
    cout &lt;&lt; endl;
    cout &lt;&lt; <span class="str">"============================"</span>  &lt;&lt; endl;
    cout &lt;&lt; <span class="str">"   🩷 כרטיס הצגה אישי 🩷"</span>    &lt;&lt; endl;
    cout &lt;&lt; <span class="str">"============================"</span>  &lt;&lt; endl;
    cout &lt;&lt; <span class="str">"שם:      "</span> &lt;&lt; name             &lt;&lt; endl;
    cout &lt;&lt; <span class="str">"גיל:     "</span> &lt;&lt; age              &lt;&lt; endl;
    cout &lt;&lt; <span class="str">"עיר:     "</span> &lt;&lt; city             &lt;&lt; endl;

    <span class="cmt">// הדפסת מצב קפה עם תנאי</span>
    <span class="kw">if</span> (loveCoffee) {
        cout &lt;&lt; <span class="str">"קפה:     כן ☕"</span> &lt;&lt; endl;
    } <span class="kw">else</span> {
        cout &lt;&lt; <span class="str">"קפה:     לא 🙅"</span> &lt;&lt; endl;
    }

    cout &lt;&lt; <span class="str">"============================"</span> &lt;&lt; endl;

    <span class="cmt">// --- תנאי גיל ---</span>
    <span class="kw">if</span> (age &gt;= 18) {
        cout &lt;&lt; <span class="str">"ברוכה הבאה, "</span> &lt;&lt; name
             &lt;&lt; <span class="str">"! את מבוגרת — יאללה לקוד! 🚀"</span> &lt;&lt; endl;
    } <span class="kw">else</span> {
        cout &lt;&lt; <span class="str">"כל הכבוד, "</span> &lt;&lt; name
             &lt;&lt; <span class="str">"! צעירה ומוכשרת — המשיכי כך! 🌟"</span> &lt;&lt; endl;
    }

    <span class="kw">return</span> 0;
}</div>

