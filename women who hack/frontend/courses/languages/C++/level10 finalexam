<script>
const correct={q1:'A',q2:'B',q3:'B',q4:'A',q5:'B',q6:'B',q7:'B',q8:'B',q9:'B',q10:'A',q11:'B',q12:'A',q13:'A',q14:'B',q15:'B',q16:'A',q17:'B',q18:'A',q19:'B',q20:'B'};
const answered={};
const total=20;

function updateStats(){
  const aCount=Object.keys(answered).length;
  const cCount=Object.keys(answered).filter(q=>answered[q]===correct[q]).length;
  document.getElementById('answered-count').textContent=aCount;
  document.getElementById('correct-count').textContent=cCount;
  const pct=Math.round(aCount/total*100);
  document.getElementById('live-pct').textContent=pct+'%';
  document.getElementById('live-fill').style.width=pct+'%';
  if(aCount===total) showScore(cCount);
}

function ans(qId,chosen,correctAns){
  if(answered[qId])return;
  answered[qId]=chosen;
  const block=document.getElementById(qId);
  block.querySelectorAll('.opt').forEach((o,i)=>{
    const l=['A','B','C'][i];
    o.classList.add('locked');
    if(l===correctAns)o.classList.add('correct');
    else if(l===chosen&&chosen!==correctAns)o.classList.add('wrong');
  });
  document.getElementById(qId+(chosen===correctAns?'-ok':'-no')).classList.add('show');
  updateStats();
}

function showScore(score){
  const pct=Math.round(score/total*100);
  document.getElementById('score-num').textContent=score;
  document.getElementById('score-pct').textContent=pct+'%';
  const msgs=[
    'נסי שוב — את יכולה יותר! 💪',
    'התחלה טובה! קראי שוב את השיעורים. 📚',
    'כבוד! עוד קצת ומגיעות לפסגה. 🌸',
    'מצוין! כמעט מושלם! 💕',
    'מושלם! את C++ Pro! 🎉🏆'
  ];
  const colors=['#e05555','#f072a9','#f072a9','#2ebd78','#d94f8a'];
  const idx=score<=7?0:score<=11?1:score<=14?2:score<=17?3:4;
  document.getElementById('score-msg').textContent=msgs[idx];
  document.getElementById('score-bar-fill').style.background=colors[idx];
  setTimeout(()=>{
    document.getElementById('score-bar-fill').style.width=pct+'%';
  },100);
  if(score<15){
    document.getElementById('score-confetti').textContent='💪🩷💪';
  }
  document.getElementById('score-section').classList.add('show');
  document.getElementById('score-section').scrollIntoView({behavior:'smooth',block:'start'});
}

function retryExam(){
  Object.keys(answered).forEach(k=>delete answered[k]);
  document.querySelectorAll('.opt').forEach(o=>{
    o.classList.remove('locked','correct','wrong');
  });
  document.querySelectorAll('.feedback').forEach(f=>{
    f.classList.remove('show');
  });
  document.getElementById('score-section').classList.remove('show');
  document.getElementById('answered-count').textContent='0';
  document.getElementById('correct-count').textContent='0';
  document.getElementById('live-pct').textContent='0%';
  document.getElementById('live-fill').style.width='0%';
  window.scrollTo({top:0,behavior:'smooth'});
}
</script>
