      <div class="section-label">📝 הקוד המלא — העתיקי, הריצי, שמחי!</div>
      <div class="code-block"><span class="kw">#include</span> <span class="str">&lt;iostream&gt;</span>
<span class="kw">#include</span> <span class="str">&lt;fstream&gt;</span>
<span class="kw">#include</span> <span class="str">&lt;string&gt;</span>
<span class="kw">#include</span> <span class="str">&lt;vector&gt;</span>
<span class="kw">using namespace</span> std;

<span class="cmt">// ─── Template function ───────────────────────</span>
<span class="kw">template</span> &lt;<span class="kw">typename</span> T&gt;
T <span class="fn">maxValue</span>(T a, T b) { <span class="kw">return</span> (a &gt; b) ? a : b; }

<span class="cmt">// ─── Base class User ─────────────────────────</span>
<span class="kw">class</span> <span class="tp">User</span> {
<span class="kw">public:</span>
    string name;
    <span class="tp">int</span> age;
    <span class="kw">static</span> <span class="tp">int</span> userCount;
    <span class="tp">bool</span> isLoggedIn;

    <span class="tp">User</span>(string n, <span class="tp">int</span> a)
        : name(n), age(a), isLoggedIn(<span class="kw">false</span>) { userCount++; }

    <span class="kw">virtual void</span> <span class="fn">showRole</span>() {
        cout &lt;&lt; name &lt;&lt; <span class="str">" is a User\n"</span>;
    }
    <span class="kw">void</span> <span class="fn">login</span>()  { isLoggedIn = <span class="kw">true</span>;  }
    <span class="kw">void</span> <span class="fn">logout</span>() { isLoggedIn = <span class="kw">false</span>; }

    <span class="kw">virtual</span> ~<span class="tp">User</span>() { cout &lt;&lt; name &lt;&lt; <span class="str">" deleted\n"</span>; }
};
<span class="tp">int</span> <span class="tp">User</span>::userCount = 0;

<span class="cmt">// ─── Derived class Admin ──────────────────────</span>
<span class="kw">class</span> <span class="tp">Admin</span> : <span class="kw">public</span> <span class="tp">User</span> {
<span class="kw">public:</span>
    <span class="tp">Admin</span>(string n, <span class="tp">int</span> a) : <span class="tp">User</span>(n, a) {}

    <span class="kw">void</span> <span class="fn">showPrivileges</span>() {
        cout &lt;&lt; name &lt;&lt; <span class="str">" has full privileges\n"</span>;
    }
    <span class="kw">void</span> <span class="fn">showRole</span>() <span class="kw">override</span> {
        cout &lt;&lt; name &lt;&lt; <span class="str">" is an Admin\n"</span>;
    }
};

<span class="cmt">// ─── Save to file ─────────────────────────────</span>
<span class="kw">void</span> <span class="fn">saveUsers</span>(<span class="kw">const</span> vector&lt;<span class="tp">User</span>*&gt;&amp; users) {
    ofstream file(<span class="str">"users.txt"</span>);
    <span class="kw">for</span> (<span class="kw">auto</span> u : users)
        file &lt;&lt; u-&gt;name &lt;&lt; <span class="str">" "</span> &lt;&lt; u-&gt;age
             &lt;&lt; <span class="str">" "</span> &lt;&lt; u-&gt;isLoggedIn &lt;&lt; <span class="str">"\n"</span>;
    file.<span class="fn">close</span>();
}

<span class="cmt">// ─── Print status ─────────────────────────────</span>
<span class="kw">void</span> <span class="fn">printUsers</span>(<span class="kw">const</span> vector&lt;<span class="tp">User</span>*&gt;&amp; users) {
    cout &lt;&lt; <span class="str">"\n=== User Status ===\n"</span>;
    <span class="kw">for</span> (<span class="kw">auto</span> u : users)
        cout &lt;&lt; u-&gt;name &lt;&lt; <span class="str">" (Age: "</span> &lt;&lt; u-&gt;age &lt;&lt; <span class="str">")"</span>
             &lt;&lt; <span class="str">" Logged in: "</span> &lt;&lt; u-&gt;isLoggedIn &lt;&lt; endl;
}

<span class="cmt">// ─── Main ─────────────────────────────────────</span>
<span class="tp">int</span> <span class="fn">main</span>() {
    vector&lt;<span class="tp">User</span>*&gt; users;

    <span class="tp">User</span>*  u1 = <span class="kw">new</span> <span class="tp">User</span> (<span class="str">"Maayan"</span>, 18);
    <span class="tp">User</span>*  u2 = <span class="kw">new</span> <span class="tp">User</span> (<span class="str">"Noa"</span>,    20);
    <span class="tp">Admin</span>* a1 = <span class="kw">new</span> <span class="tp">Admin</span>(<span class="str">"Dana"</span>,   25);

    users.<span class="fn">push_back</span>(u1);
    users.<span class="fn">push_back</span>(u2);
    users.<span class="fn">push_back</span>(a1);

    u1-&gt;<span class="fn">login</span>();
    a1-&gt;<span class="fn">login</span>();

    <span class="cmt">// Polymorphism!</span>
    <span class="kw">for</span> (<span class="kw">auto</span> u : users) u-&gt;<span class="fn">showRole</span>();

    a1-&gt;<span class="fn">showPrivileges</span>();
    <span class="fn">printUsers</span>(users);
    <span class="fn">saveUsers</span>(users);

    cout &lt;&lt; <span class="str">"Max score: "</span> &lt;&lt; <span class="fn">maxValue</span>&lt;<span class="tp">int</span>&gt;(87, 95) &lt;&lt; endl;
    cout &lt;&lt; <span class="str">"Total users: "</span> &lt;&lt; <span class="tp">User</span>::userCount &lt;&lt; endl;

    <span class="kw">for</span> (<span class="kw">auto</span> u : users) <span class="kw">delete</span> u;
    users.<span class="fn">clear</span>();
    <span class="kw">return</span> 0;
}</div>

