<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>שיעור 19 — פונקציות רקורסיביות | Women Who Hack C++</title>
<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=Baloo+2:wght@400;600;800&display=swap" rel="stylesheet"/>
<style>
:root{--pink-bg:#fff0f5;--pink-light:#ffe4ef;--pink-mid:#ffb6d9;--pink-dark:#f072a9;--pink-deep:#d94f8a;--pink-accent:#ff8cc8;--white:#ffffff;--text-dark:#3d1a2e;--text-mid:#7a3060;--text-light:#b56090;--shadow:rgba(240,114,169,.18);--green:#2ebd78;--green-bg:#edfbf3;--green-border:#a8edcc;--red:#e05555;--red-bg:#fdeaea;--red-border:#f5b8b8}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Quicksand',sans-serif;background:var(--pink-bg);color:var(--text-dark);min-height:100vh;overflow-x:hidden}
body::before{content:'';position:fixed;top:-120px;left:-120px;width:500px;height:500px;background:radial-gradient(circle,#ffd6ec 0%,transparent 70%);z-index:0;pointer-events:none}
body::after{content:'';position:fixed;bottom:-100px;right:-100px;width:400px;height:400px;background:radial-gradient(circle,#ffcce5 0%,transparent 70%);z-index:0;pointer-events:none}
nav{position:relative;z-index:2;background:var(--white);border-bottom:1.5px solid #ffd6ec;padding:13px 24px;display:flex;align-items:center;justify-content:space-between;box-shadow:0 2px 12px var(--shadow)}
.nav-logo{font-family:'Baloo 2',cursive;font-weight:800;font-size:1rem;color:var(--pink-deep);text-decoration:none}
.nav-back{display:flex;align-items:center;gap:6px;color:var(--text-mid);text-decoration:none;font-size:.85rem;font-weight:600;padding:7px 16px;border-radius:50px;background:var(--pink-bg);border:1.5px solid var(--pink-mid);transition:background .2s}
.nav-back:hover{background:var(--pink-light)}
.nav-badge{font-size:.78rem;font-weight:700;color:var(--pink-deep);background:var(--pink-light);border:1.5px solid var(--pink-mid);padding:5px 14px;border-radius:50px}
.hero{position:relative;z-index:1;text-align:center;padding:42px 20px 28px}
.hero-tag{display:inline-block;background:var(--pink-mid);color:var(--pink-deep);font-size:.76rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:5px 18px;border-radius:50px;margin-bottom:14px}
.hero h1{font-family:'Baloo 2',cursive;font-size:clamp(1.7rem,5vw,2.6rem);font-weight:800;color:var(--pink-deep);line-height:1.2}
.hero p{margin-top:10px;font-size:.95rem;color:var(--text-light);font-weight:500}
.progress-wrap{max-width:400px;margin:18px auto 0}
.prog-labels{display:flex;justify-content:space-between;font-size:.78rem;font-weight:600;color:var(--text-mid);margin-bottom:6px}
.prog-bar{height:10px;background:#ffd6ec;border-radius:50px;overflow:hidden}
.prog-fill{height:100%;background:linear-gradient(90deg,var(--pink-dark),var(--pink-deep));border-radius:50px}
.wrap{max-width:760px;margin:0 auto;padding:10px 22px 80px;position:relative;z-index:1}
.card{background:var(--white);border-radius:20px;box-shadow:0 6px 28px var(--shadow);border:1.5px solid #ffd6ec;margin-bottom:22px;overflow:hidden;animation:fadeUp .5s ease both}
@keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.card:nth-child(1){animation-delay:.05s}.card:nth-child(2){animation-delay:.12s}.card:nth-child(3){animation-delay:.19s}.card:nth-child(4){animation-delay:.26s}.card:nth-child(5){animation-delay:.33s}.card:nth-child(6){animation-delay:.40s}.card:nth-child(7){animation-delay:.47s}.card:nth-child(8){animation-delay:.54s}
.card-head{background:linear-gradient(135deg,var(--pink-dark),var(--pink-accent));padding:16px 22px;display:flex;align-items:center;gap:12px}
.head-icon{font-size:1.3rem}
.card-head h2{font-family:'Baloo 2',cursive;font-size:1rem;font-weight:800;color:var(--white)}
.card-body{padding:20px 22px}
.recap-box{background:var(--pink-bg);border:1.5px solid var(--pink-mid);border-radius:12px;padding:12px 16px;font-size:.88rem;color:var(--text-mid);font-weight:600;line-height:1.65}
.goal-list{list-style:none;display:flex;flex-direction:column;gap:8px}
.goal-list li{display:flex;align-items:flex-start;gap:9px;font-size:.9rem;color:var(--text-mid);font-weight:600;line-height:1.55}
.gdot{width:9px;height:9px;border-radius:50%;background:var(--pink-dark);flex-shrink:0;margin-top:6px}
.concepts-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(185px,1fr));gap:10px}
.concept-box{background:var(--pink-bg);border:1.5px solid #ffd6ec;border-radius:14px;padding:12px 14px}
.concept-term{font-family:'Baloo 2',cursive;font-size:.9rem;font-weight:800;color:var(--pink-deep);margin-bottom:4px}
.concept-desc{font-size:.82rem;color:var(--text-mid);line-height:1.55;font-weight:500}
.example-box{background:linear-gradient(135deg,#fff0f8,#ffe4ef);border:1.5px solid var(--pink-mid);border-radius:14px;padding:14px 16px;font-size:.9rem;color:var(--text-mid);line-height:1.7;font-weight:500}
.example-box strong{color:var(--pink-deep)}
.ex-list{list-style:none;counter-reset:ex;display:flex;flex-direction:column;gap:9px}
.ex-list li{counter-increment:ex;display:flex;align-items:flex-start;gap:10px;font-size:.9rem;color:var(--text-mid);font-weight:600;line-height:1.55}
.ex-list li::before{content:counter(ex);background:var(--pink-mid);color:var(--pink-deep);font-weight:800;font-size:.72rem;min-width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px}
.code-block{background:#2d1b26;border-radius:14px;padding:16px 18px;font-family:'Courier New',monospace;font-size:.82rem;line-height:1.9;color:#f8d6e8;overflow-x:auto;direction:ltr;text-align:left;margin-top:6px}
.kw{color:#ffb6d9}.fn{color:#7ee8c0}.str{color:#ffd68a}.cmt{color:#7a5070;font-style:italic}.tp{color:#b8f0c8}
.section-label{font-family:'Baloo 2',cursive;font-size:.82rem;font-weight:800;color:var(--pink-deep);text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px}
/* recursion steps visual */
.rec-steps{display:flex;flex-direction:column;gap:6px;margin:14px 0}
.rec-step{display:flex;align-items:center;gap:10px;padding:9px 14px;border-radius:12px;border:1.5px solid #ffd6ec;background:var(--pink-bg)}
.rec-step.base{background:var(--green-bg);border-color:var(--green-border)}
.rec-step.returning{background:#fff8e0;border-color:#f5d87a}
.rs-num{font-family:'Baloo 2',cursive;font-size:.78rem;font-weight:800;color:var(--pink-deep);min-width:80px}
.rs-num.base-lbl{color:#1a6640}
.rs-num.ret-lbl{color:#8a5a00}
.rs-code{font-family:'Courier New',monospace;font-size:.82rem;color:var(--text-dark);font-weight:600}
/* two-col */
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.col-box{background:var(--pink-bg);border:1.5px solid var(--pink-mid);border-radius:14px;padding:14px}
.col-title{font-family:'Baloo 2',cursive;font-size:.88rem;font-weight:800;color:var(--pink-deep);margin-bottom:8px}
/* quiz */
.quiz-card{background:var(--white);border-radius:20px;box-shadow:0 6px 28px var(--shadow);border:2px solid var(--pink-mid);margin-bottom:22px;overflow:hidden;animation:fadeUp .5s ease .5s both}
.quiz-head{background:linear-gradient(135deg,var(--pink-deep),var(--pink-dark));padding:16px 22px;display:flex;align-items:center;gap:12px}
.quiz-head h2{font-family:'Baloo 2',cursive;font-size:1rem;font-weight:800;color:var(--white)}
.quiz-body{padding:22px}
.q-block{margin-bottom:24px}.q-block:last-child{margin-bottom:0}
.q-num{display:inline-block;background:var(--pink-mid);color:var(--pink-deep);font-size:.72rem;font-weight:800;padding:3px 10px;border-radius:50px;margin-bottom:8px}
.q-text{font-size:.95rem;font-weight:700;color:var(--text-dark);margin-bottom:12px;line-height:1.5}
.q-code{background:#2d1b26;border-radius:10px;padding:10px 14px;font-family:'Courier New',monospace;font-size:.8rem;color:#f8d6e8;direction:ltr;text-align:left;margin-bottom:12px;line-height:1.7}
.options{display:flex;flex-direction:column;gap:8px}
.opt{display:flex;align-items:center;gap:10px;padding:11px 14px;border-radius:12px;border:1.5px solid #ffd6ec;background:var(--pink-bg);cursor:pointer;font-size:.88rem;font-weight:600;color:var(--text-mid);transition:all .2s;user-select:none}
.opt:hover:not(.locked){background:var(--pink-light);border-color:var(--pink-mid)}
.opt.correct{background:var(--green-bg);border-color:var(--green-border);color:#1a6640}
.opt.wrong{background:var(--red-bg);border-color:var(--red-border);color:#7a1a1a}
.opt.locked{cursor:default}
.opt-letter{min-width:26px;height:26px;border-radius:50%;background:var(--pink-mid);color:var(--pink-deep);font-size:.75rem;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.opt.correct .opt-letter{background:var(--green);color:#fff}.opt.wrong .opt-letter{background:var(--red);color:#fff}
.feedback{margin-top:10px;padding:10px 14px;border-radius:10px;font-size:.85rem;font-weight:600;line-height:1.55;display:none}
.feedback.show{display:block}
.feedback.fb-correct{background:var(--green-bg);border:1.5px solid var(--green-border);color:#1a6640}
.feedback.fb-wrong{background:var(--red-bg);border:1.5px solid var(--red-border);color:#7a1a1a}
.q-divider{border:none;border-top:1.5px dashed var(--pink-mid);margin:22px 0}
.score-box{display:none;background:linear-gradient(135deg,var(--pink-light),#fff0f8);border:2px solid var(--pink-mid);border-radius:16px;padding:20px 22px;text-align:center;margin-top:18px}
.score-box.show{display:block}
.score-num{font-family:'Baloo 2',cursive;font-size:2.4rem;font-weight:800;color:var(--pink-deep)}
.score-msg{font-size:.92rem;font-weight:600;color:var(--text-mid);margin-top:6px}
.nav-footer{max-width:760px;margin:0 auto;padding:0 22px 50px;display:flex;justify-content:space-between;align-items:center;position:relative;z-index:1;flex-wrap:wrap;gap:12px}
.btn-nav{display:flex;align-items:center;gap:7px;padding:11px 22px;border-radius:50px;font-family:'Quicksand',sans-serif;font-size:.88rem;font-weight:700;text-decoration:none;border:1.5px solid var(--pink-mid);background:var(--white);color:var(--text-mid);transition:all .2s;box-shadow:0 3px 10px var(--shadow)}
.btn-nav:hover{background:var(--pink-light)}
.btn-nav.primary{background:linear-gradient(135deg,var(--pink-dark),var(--pink-deep));border-color:transparent;color:var(--white)}
.btn-nav.primary:hover{opacity:.88}
@media(max-width:600px){.two-col{grid-template-columns:1fr}.wrap{padding:10px 14px 60px}.nav-footer{padding:0 14px 40px}}
</style>
</head>
<body>
<nav>
  <a href="index.html" class="nav-logo">🩷 Women Who Hack C++</a>
  <span class="nav-badge">Level 5 · שיעור 19 מתוך 20</span>
  <a href="index.html" class="nav-back">← חזרה לקורס</a>
</nav>
<div class="hero">
  <div class="hero-tag">🌸 Level 5 · שיעור 19</div>
  <h1>פונקציות רקורסיביות</h1>
  <p>פונקציה שקוראת לעצמה — קסם של תכנות! 🔄✨</p>
  <div class="progress-wrap">
    <div class="prog-labels"><span>Level 5</span><span>שיעור 19 / 20</span></div>
    <div class="prog-bar"><div class="prog-fill" style="width:75%"></div></div>
  </div>
</div>
<div class="wrap">

  <div class="card">
    <div class="card-head"><span class="head-icon">🔄</span><h2>חזרה קצרה — שיעור 18</h2></div>
    <div class="card-body">
      <div class="recap-box">בשיעור 18 למדנו פונקציות שמקבלות <strong>מערכים כפרמטרים</strong> — ראינו שמועבר פוינטר, ולכן שינויים בפונקציה משפיעים על המקור. עכשיו נלמד רקורסיה — פונקציות שקוראות <strong>לעצמן</strong>! 🔄</div>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><span class="head-icon">🎯</span><h2>מטרות השיעור</h2></div>
    <div class="card-body">
      <ul class="goal-list">
        <li><span class="gdot"></span>להבין מהי רקורסיה ואיך פונקציה קוראת לעצמה</li>
        <li><span class="gdot"></span>להכיר את שני חלקי כל פונקציה רקורסיבית: Base Case ו-Recursive Case</li>
        <li><span class="gdot"></span>לכתוב factorial ו-Fibonacci רקורסיביים</li>
        <li><span class="gdot"></span>להבין מתי עדיף רקורסיה ומתי לולאה</li>
      </ul>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><span class="head-icon">🤔</span><h2>מה זו רקורסיה?</h2></div>
    <div class="card-body">
      <div class="example-box" style="margin-bottom:16px">
        <strong>🪆 בובות רוסיות —</strong><br/>
        כל בובה מכילה בובה קטנה יותר — עד שמגיעים לבובה הקטנה ביותר שאין בה עוד בובות. זה בדיוק רקורסיה: פונקציה שקוראת לעצמה עם פרמטר קטן יותר, עד שמגיעים לתנאי עצירה!
      </div>
      <div class="concepts-grid">
        <div class="concept-box">
          <div class="concept-term">Recursion (רקורסיה)</div>
          <div class="concept-desc">פונקציה שבגופה קוראת לעצמה — עם ערך קטן יותר בכל פעם.</div>
        </div>
        <div class="concept-box">
          <div class="concept-term">Base Case (תנאי עצירה)</div>
          <div class="concept-desc">התנאי שמפסיק את הרקורסיה — חובה! בלעדיו — לולאה אינסופית.</div>
        </div>
        <div class="concept-box">
          <div class="concept-term">Recursive Case</div>
          <div class="concept-desc">הקריאה לעצמה עם ערך קטן יותר — מתקרבים לתנאי העצירה בכל פעם.</div>
        </div>
        <div class="concept-box">
          <div class="concept-term">Call Stack</div>
          <div class="concept-desc">המחשב שומר כל קריאה ב"מחסנית" — ומחזיר ערכים בסדר הפוך.</div>
        </div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><span class="head-icon">🔢</span><h2>דוגמה קלאסית — Factorial</h2></div>
    <div class="card-body">
      <p style="font-size:.9rem;color:var(--text-mid);font-weight:600;margin-bottom:12px;line-height:1.6">פקטוריאל: <strong style="color:var(--pink-deep)">5! = 5×4×3×2×1 = 120</strong><br/>הגדרה רקורסיבית: n! = n × (n-1)! כאשר 0! = 1</p>
      <div class="code-block"><span class="tp">int</span> <span class="fn">factorial</span>(<span class="tp">int</span> n) {
    <span class="cmt">// Base Case — תנאי עצירה</span>
    <span class="kw">if</span> (n == 0) <span class="kw">return</span> 1;

    <span class="cmt">// Recursive Case — קריאה לעצמה</span>
    <span class="kw">return</span> n * <span class="fn">factorial</span>(n - 1);
}

<span class="cmt">// factorial(4) = 4 * factorial(3)
//              = 4 * 3 * factorial(2)
//              = 4 * 3 * 2 * factorial(1)
//              = 4 * 3 * 2 * 1 * factorial(0)
//              = 4 * 3 * 2 * 1 * 1 = 24</span></div>
      <br/>
      <div class="section-label">🔬 מה קורה בזיכרון?</div>
      <div class="rec-steps">
        <div class="rec-step"><span class="rs-num">קריאה 1:</span><span class="rs-code">factorial(4) → מחכה ל-factorial(3)</span></div>
        <div class="rec-step"><span class="rs-num">קריאה 2:</span><span class="rs-code">factorial(3) → מחכה ל-factorial(2)</span></div>
        <div class="rec-step"><span class="rs-num">קריאה 3:</span><span class="rs-code">factorial(2) → מחכה ל-factorial(1)</span></div>
        <div class="rec-step"><span class="rs-num">קריאה 4:</span><span class="rs-code">factorial(1) → מחכה ל-factorial(0)</span></div>
        <div class="rec-step base"><span class="rs-num base-lbl">Base Case! ✅</span><span class="rs-code">factorial(0) → מחזירה 1</span></div>
        <div class="rec-step returning"><span class="rs-num ret-lbl">חזרה ↑</span><span class="rs-code">1→1→2→6→24 — התשובה בונה את עצמה!</span></div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><span class="head-icon">🌀</span><h2>דוגמה נוספת — Fibonacci</h2></div>
    <div class="card-body">
      <p style="font-size:.9rem;color:var(--text-mid);font-weight:600;margin-bottom:12px;line-height:1.6">סדרת פיבונאצ'י: <strong style="color:var(--pink-deep)">0, 1, 1, 2, 3, 5, 8, 13...</strong><br/>כל מספר = סכום שני קודמיו. fib(n) = fib(n-1) + fib(n-2)</p>
      <div class="code-block"><span class="tp">int</span> <span class="fn">fib</span>(<span class="tp">int</span> n) {
    <span class="cmt">// שני Base Cases!</span>
    <span class="kw">if</span> (n == 0) <span class="kw">return</span> 0;
    <span class="kw">if</span> (n == 1) <span class="kw">return</span> 1;

    <span class="cmt">// Recursive Case — שתי קריאות!</span>
    <span class="kw">return</span> <span class="fn">fib</span>(n - 1) + <span class="fn">fib</span>(n - 2);
}

<span class="cmt">// fib(5) = fib(4) + fib(3) = 3 + 2 = 5</span></div>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><span class="head-icon">⚖️</span><h2>רקורסיה vs לולאה</h2></div>
    <div class="card-body">
      <div class="two-col">
        <div class="col-box">
          <div class="col-title">✅ מתי רקורסיה?</div>
          <ul class="goal-list">
            <li><span class="gdot"></span>הבעיה מוגדרת רקורסיבית (factorial, Fibonacci)</li>
            <li><span class="gdot"></span>עצי נתונים ומבני נתונים מורכבים</li>
            <li><span class="gdot"></span>הקוד קצר וקריא יותר</li>
          </ul>
        </div>
        <div class="col-box">
          <div class="col-title">⚡ מתי לולאה?</div>
          <ul class="goal-list">
            <li><span class="gdot"></span>ביצועים חשובים — לולאה מהירה יותר</li>
            <li><span class="gdot"></span>מספר הסיבובים ידוע מראש</li>
            <li><span class="gdot"></span>מעבר פשוט על מערך או רשימה</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><span class="head-icon">🌸</span><h2>דוגמה מחיי היום-יום</h2></div>
    <div class="card-body">
      <div class="example-box">
        <strong>📁 תיקיות במחשב —</strong><br/>
        חיפוש קובץ בתיקייה שמכילה תת-תיקיות — רקורסיה מושלמת! "חפשי בתיקייה הזו, ואם יש תת-תיקיות — חפשי גם בהן" — כל תת-תיקייה קוראת לאותה פונקציה על עצמה.<br/><br/>
        <strong>🌳 עץ משפחה —</strong><br/>
        "כמה צאצאים יש לסבא?" — סכום הצאצאים של כל ילד, שזה סכום הצאצאים של נכדיהם... רקורסיה טבעית!
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><span class="head-icon">✏️</span><h2>תרגול</h2></div>
    <div class="card-body">
      <ol class="ex-list">
        <li>כתבי פונקציה רקורסיבית <strong style="color:var(--pink-deep)">power(base, exp)</strong> שמחשבת חזקה: base^exp</li>
        <li>כתבי פונקציה רקורסיבית <strong style="color:var(--pink-deep)">sumDigits(n)</strong> שמחשבת סכום ספרות של מספר</li>
        <li>בונוס: כתבי פונקציה רקורסיבית שמדפיסה ספירה לאחור מ-n עד 0</li>
      </ol>
    </div>
  </div>

  <div class="quiz-card">
    <div class="quiz-head"><span style="font-size:1.2rem">🧠</span><h2>מבחן — שיעור 19</h2></div>
    <div class="quiz-body">

      <div class="q-block" id="q1">
        <div class="q-num">שאלה 1 מתוך 3</div>
        <div class="q-text">מה הוא ה-<strong>Base Case</strong> בפונקציה רקורסיבית?</div>
        <div class="options">
          <div class="opt" onclick="answer('q1','A','B')"><span class="opt-letter">A</span>הקריאה של הפונקציה לעצמה</div>
          <div class="opt" onclick="answer('q1','B','B')"><span class="opt-letter">B</span>תנאי העצירה — שמונע מהרקורסיה להמשיך לאינסוף</div>
          <div class="opt" onclick="answer('q1','C','B')"><span class="opt-letter">C</span>הפרמטר הראשון של הפונקציה</div>
        </div>
        <div class="feedback fb-correct" id="q1-ok">✅ נכון! ה-Base Case הוא תנאי העצירה — בלעדיו הפונקציה תקרא לעצמה לנצח וה-stack יתמלא 🎉</div>
        <div class="feedback fb-wrong" id="q1-no">❌ ה-Base Case הוא תנאי העצירה של הרקורסיה — כמו if(n==0) return 1 ב-factorial.</div>
      </div>

      <hr class="q-divider"/>

      <div class="q-block" id="q2">
        <div class="q-num">שאלה 2 מתוך 3</div>
        <div class="q-text">מה תחזיר הפונקציה <span style="font-family:monospace;color:var(--pink-deep)">factorial(3)</span>?</div>
        <div class="q-code"><span style="color:#b8f0c8">int</span> <span style="color:#7ee8c0">factorial</span>(<span style="color:#b8f0c8">int</span> n) {
    <span style="color:#ffb6d9">if</span> (n == 0) <span style="color:#ffb6d9">return</span> 1;
    <span style="color:#ffb6d9">return</span> n * <span style="color:#7ee8c0">factorial</span>(n - 1);
}</div>
        <div class="options">
          <div class="opt" onclick="answer('q2','A','B')"><span class="opt-letter">A</span>3</div>
          <div class="opt" onclick="answer('q2','B','B')"><span class="opt-letter">B</span>6</div>
          <div class="opt" onclick="answer('q2','C','B')"><span class="opt-letter">C</span>9</div>
        </div>
        <div class="feedback fb-correct" id="q2-ok">✅ מדויק! 3! = 3×2×1 = 6. factorial(3) = 3 * factorial(2) = 3 * 2 * 1 = 6 🩷</div>
        <div class="feedback fb-wrong" id="q2-no">❌ factorial(3) = 3 × factorial(2) = 3 × 2 × factorial(1) = 3 × 2 × 1 = 6.</div>
      </div>

      <hr class="q-divider"/>

      <div class="q-block" id="q3">
        <div class="q-num">שאלה 3 מתוך 3</div>
        <div class="q-text">מה יקרה אם נכתוב פונקציה רקורסיבית <strong>ללא Base Case</strong>?</div>
        <div class="options">
          <div class="opt" onclick="answer('q3','A','A')"><span class="opt-letter">A</span>הפונקציה תקרא לעצמה לאינסוף עד שהתוכנית תקרוס (Stack Overflow)</div>
          <div class="opt" onclick="answer('q3','B','A')"><span class="opt-letter">B</span>הפונקציה תחזיר 0 אוטומטית</div>
          <div class="opt" onclick="answer('q3','C','A')"><span class="opt-letter">C</span>הקוד לא יקמפל</div>
        </div>
        <div class="feedback fb-correct" id="q3-ok">✅ נכון! ללא Base Case — הרקורסיה לעולם לא תיעצר, ה-Call Stack ימלא וה-תוכנית תקרוס 🎉</div>
        <div class="feedback fb-wrong" id="q3-no">❌ ללא Base Case — הפונקציה תקרא לעצמה לאינסוף. ה-Call Stack ימלא ויגרום ל-Stack Overflow!</div>
      </div>

      <div class="score-box" id="score-box">
        <div class="score-num" id="score-num"></div>
        <div class="score-msg" id="score-msg"></div>
      </div>
    </div>
  </div>

</div>
<div class="nav-footer">
  <a href="level5-lesson18.html" class="btn-nav">← שיעור 18 — פונקציות עם מערכים</a>
  <a href="level5-lesson20.html" class="btn-nav primary">שיעור 20 — ערכים לפי Reference ←</a>
</div>
<script>
const correct={q1:'B',q2:'B',q3:'A'};const answered={};const total=Object.keys(correct).length;
function answer(qId,chosen,correctAns){
  if(answered[qId])return;answered[qId]=chosen;
  const block=document.getElementById(qId);
  block.querySelectorAll('.opt').forEach((o,i)=>{const l=['A','B','C'][i];o.classList.add('locked');if(l===correctAns)o.classList.add('correct');else if(l===chosen&&chosen!==correctAns)o.classList.add('wrong');});
  document.getElementById(qId+(chosen===correctAns?'-ok':'-no')).classList.add('show');
  if(Object.keys(answered).length===total){
    let score=Object.keys(answered).filter(q=>answered[q]===correct[q]).length;
    document.getElementById('score-num').textContent=score+' / '+total;
    document.getElementById('score-msg').textContent=['נסי שוב! 💪','כמעט! 🌸','יפה מאוד! 💕','מושלם! ממשיכות לשיעור 20! 🎉'][score];
    document.getElementById('score-box').classList.add('show');
  }
}
</script>
