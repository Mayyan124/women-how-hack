  <div class="quiz-card">
    <div class="quiz-head"><span style="font-size:1.2rem">🧠</span><h2>מבחן — שיעור 31</h2></div>
    <div class="quiz-body">
      <div class="q-block" id="q1">
        <div class="q-num">שאלה 1 מתוך 1</div>
        <div class="q-text">משתנה <code>private</code> ניתן לגישה מ:</div>
        <div class="options">
          <div class="opt" onclick="answer('q1','A','B')"><span class="opt-letter">A</span>מחלקה אחרת</div>
          <div class="opt" onclick="answer('q1','B','B')"><span class="opt-letter">B</span>אותה מחלקה בלבד</div>
          <div class="opt" onclick="answer('q1','C','B')"><span class="opt-letter">C</span>כל אובייקט בתוכנית</div>
        </div>
        <div class="feedback fb-correct" id="q1-ok">✅ נכון! <code>private</code> = נגיש מאותה מחלקה בלבד. זה בדיוק מה שנותן לנו הגנה על הנתונים! 🔐🎉</div>
        <div class="feedback fb-wrong" id="q1-no">❌ משתנה <code>private</code> נגיש רק מ<strong>אותה מחלקה</strong>. לא ממחלקות אחרות ולא מבחוץ — זה כל הרעיון של Encapsulation!</div>
      </div>
      <div class="score-box" id="score-box">
        <div class="score-num" id="score-num"></div>
        <div class="score-msg" id="score-msg"></div>
      </div>
    </div>
  </div>

</div>

<div class="nav-footer">
  <a href="level8-lesson30.html" class="btn-nav">← שיעור 30</a>
  <a href="level8-lesson32.html" class="btn-nav primary">שיעור 32 — תרגול מורש ומורכב ←</a>
</div>

<script>
const correct={q1:'B'};const answered={};const total=Object.keys(correct).length;
function answer(qId,chosen,correctAns){
  if(answered[qId])return;answered[qId]=chosen;
  const block=document.getElementById(qId);
  block.querySelectorAll('.opt').forEach((o,i)=>{const l=['A','B','C'][i];o.classList.add('locked');if(l===correctAns)o.classList.add('correct');else if(l===chosen&&chosen!==correctAns)o.classList.add('wrong');});
  document.getElementById(qId+(chosen===correctAns?'-ok':'-no')).classList.add('show');
  if(Object.keys(answered).length===total){
    let score=Object.keys(answered).filter(q=>answered[q]===correct[q]).length;
    document.getElementById('score-num').textContent=score+' / '+total;
    document.getElementById('score-msg').textContent=score===1?'מושלם! ממשיכות לשיעור 32! 🎉':'נסי שוב! 💪';
    document.getElementById('score-box').classList.add('show');
  }
}
</script>
