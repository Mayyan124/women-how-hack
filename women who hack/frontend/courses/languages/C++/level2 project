        <div class="section-label">📝 קוד התשובה המלאה</div>
        <div class="code-block"><span class="kw">#include</span> &lt;iostream&gt;
<span class="kw">using namespace</span> std;

<span class="cmt">// --- הגדרת struct ---</span>
<span class="kw">struct</span> <span class="tp">User</span> {
    <span class="tp">string</span> name;
    <span class="tp">int</span>    age;
    <span class="tp">bool</span>   isLoggedIn;
};

<span class="cmt">// --- פונקציה שבודקת גישה ---</span>
<span class="tp">string</span> <span class="fn">checkAccess</span>(<span class="tp">User</span> u) {
    <span class="kw">if</span> (u.age &gt;= 18 &amp;&amp; u.isLoggedIn) {
        <span class="kw">return</span> <span class="str">"Access granted ✅"</span>;
    } <span class="kw">else</span> {
        <span class="kw">return</span> <span class="str">"Access denied ❌"</span>;
    }
}

<span class="kw">int</span> <span class="fn">main</span>() {

    <span class="cmt">// --- יצירת מערך משתמשות ---</span>
    <span class="tp">User</span> users[3] = {
        {<span class="str">"Maayan"</span>, 18, <span class="kw">true</span>},
        {<span class="str">"Dana"</span>,   15, <span class="kw">true</span>},
        {<span class="str">"Noa"</span>,    22, <span class="kw">false</span>}
    };

    <span class="cmt">// --- הדפסת כותרת ---</span>
    cout &lt;&lt; <span class="str">"============================"</span> &lt;&lt; endl;
    cout &lt;&lt; <span class="str">"   🩷 Smart User System 🩷"</span>   &lt;&lt; endl;
    cout &lt;&lt; <span class="str">"============================"</span> &lt;&lt; endl;

    <span class="cmt">// --- לולאה על כל המשתמשות ---</span>
    <span class="tp">int</span> grantedCount = 0;
    <span class="kw">for</span> (<span class="tp">int</span> i = 0; i &lt; 3; i++) {
        <span class="tp">string</span> result = <span class="fn">checkAccess</span>(users[i]);
        cout &lt;&lt; users[i].name
             &lt;&lt; <span class="str">" ("</span> &lt;&lt; users[i].age &lt;&lt; <span class="str">"): "</span>
             &lt;&lt; result &lt;&lt; endl;
        <span class="kw">if</span> (users[i].age &gt;= 18 &amp;&amp; users[i].isLoggedIn)
            grantedCount++;
    }

    <span class="cmt">// --- סיכום ---</span>
    cout &lt;&lt; <span class="str">"============================"</span> &lt;&lt; endl;
    cout &lt;&lt; <span class="str">"סיכום: "</span> &lt;&lt; grantedCount
         &lt;&lt; <span class="str">" מתוך 3 משתמשות קיבלו גישה."</span> &lt;&lt; endl;

    <span class="kw">return</span> 0;
}</div>

