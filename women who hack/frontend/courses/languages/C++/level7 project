body{font-family:'Quicksand',sans-serif;background:var(--pink-bg);color:var(--text-dark);min-height:100vh;overflow-x:hidden}
body::before{content:'';position:fixed;top:-120px;left:-120px;width:500px;height:500px;background:radial-gradient(circle,#ffd6ec 0%,transparent 70%);z-index:0;pointer-events:none}
body::after{content:'';position:fixed;bottom:-100px;right:-100px;width:400px;height:400px;background:radial-gradient(circle,#ffcce5 0%,transparent 70%);z-index:0;pointer-events:none}
nav{position:relative;z-index:2;background:var(--white);border-bottom:1.5px solid #ffd6ec;padding:13px 24px;display:flex;align-items:center;justify-content:space-between;box-shadow:0 2px 12px var(--shadow)}
.nav-logo{font-family:'Baloo 2',cursive;font-weight:800;font-size:1rem;color:var(--pink-deep);text-decoration:none}
.nav-back{display:flex;align-items:center;gap:6px;color:var(--text-mid);text-decoration:none;font-size:.85rem;font-weight:600;padding:7px 16px;border-radius:50px;background:var(--pink-bg);border:1.5px solid var(--pink-mid);transition:background .2s}
.nav-back:hover{background:var(--pink-light)}
.nav-badge{font-size:.78rem;font-weight:700;color:var(--gold);background:var(--gold-bg);border:1.5px solid var(--gold-border);padding:5px 14px;border-radius:50px}
.hero{position:relative;z-index:1;text-align:center;padding:42px 20px 28px}
.hero-tag{display:inline-block;background:linear-gradient(135deg,var(--gold),#f5c842);color:#7a5000;font-size:.76rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:5px 18px;border-radius:50px;margin-bottom:14px}
.hero h1{font-family:'Baloo 2',cursive;font-size:clamp(1.7rem,5vw,2.6rem);font-weight:800;color:var(--pink-deep);line-height:1.2}
.hero p{margin-top:10px;font-size:.95rem;color:var(--text-light);font-weight:500}
.hero-badge-row{display:flex;justify-content:center;gap:10px;margin-top:16px;flex-wrap:wrap}
.hbadge{background:var(--pink-light);border:1.5px solid var(--pink-mid);border-radius:50px;padding:6px 16px;font-size:.78rem;font-weight:700;color:var(--pink-deep)}
.wrap{max-width:760px;margin:0 auto;padding:10px 22px 80px;position:relative;z-index:1}
.card{background:var(--white);border-radius:20px;box-shadow:0 6px 28px var(--shadow);border:1.5px solid #ffd6ec;margin-bottom:22px;overflow:hidden;animation:fadeUp .5s ease both}
@keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.card:nth-child(1){animation-delay:.05s}.card:nth-child(2){animation-delay:.12s}.card:nth-child(3){animation-delay:.19s}.card:nth-child(4){animation-delay:.26s}.card:nth-child(5){animation-delay:.33s}.card:nth-child(6){animation-delay:.40s}
.card-head{background:linear-gradient(135deg,var(--pink-dark),var(--pink-accent));padding:16px 22px;display:flex;align-items:center;gap:12px}
.card-head.gold-head{background:linear-gradient(135deg,#e8a800,#f5c842)}
.head-icon{font-size:1.3rem}
.card-head h2{font-family:'Baloo 2',cursive;font-size:1rem;font-weight:800;color:var(--white)}
.card-head.gold-head h2{color:#4a3000}
.card-body{padding:20px 22px}
.goal-list{list-style:none;display:flex;flex-direction:column;gap:8px}
.goal-list li{display:flex;align-items:flex-start;gap:9px;font-size:.9rem;color:var(--text-mid);font-weight:600;line-height:1.55}
.gdot{width:9px;height:9px;border-radius:50%;background:var(--pink-dark);flex-shrink:0;margin-top:6px}
.gdot.gold{background:var(--gold)}
.steps-list{display:flex;flex-direction:column;gap:14px}
.step{display:flex;align-items:flex-start;gap:14px}
.step-num{min-width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--pink-dark),var(--pink-deep));color:var(--white);font-family:'Baloo 2',cursive;font-size:.9rem;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px}
.step-body{flex:1}
.step-title{font-family:'Baloo 2',cursive;font-size:.92rem;font-weight:800;color:var(--pink-deep);margin-bottom:4px}
.step-desc{font-size:.84rem;color:var(--text-mid);font-weight:600;line-height:1.55}
.step-code{font-family:'Courier New',monospace;font-size:.76rem;background:var(--pink-bg);border:1px solid var(--pink-mid);padding:4px 8px;border-radius:6px;display:inline-block;margin-top:4px;color:var(--pink-deep)}
.code-block{background:#2d1b26;border-radius:14px;padding:16px 18px;font-family:'Courier New',monospace;font-size:.82rem;line-height:1.9;color:#f8d6e8;overflow-x:auto;direction:ltr;text-align:left;margin-top:6px}
.kw{color:#ffb6d9}.fn{color:#7ee8c0}.str{color:#ffd68a}.cmt{color:#7a5070;font-style:italic}.tp{color:#b8f0c8}.num{color:#c9a8f5}
.output-box{background:#1a1a2e;border-radius:12px;padding:14px 16px;font-family:'Courier New',monospace;font-size:.83rem;color:#a8f0c8;direction:ltr;text-align:left;margin-top:6px;line-height:1.8}
.output-line.del{color:#f08080}
.section-label{font-family:'Baloo 2',cursive;font-size:.82rem;font-weight:800;color:var(--pink-deep);text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px}
.concepts-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(185px,1fr));gap:10px}
.concept-box{background:var(--pink-bg);border:1.5px solid #ffd6ec;border-radius:14px;padding:12px 14px}
.concept-term{font-family:'Baloo 2',cursive;font-size:.9rem;font-weight:800;color:var(--pink-deep);margin-bottom:4px}
.concept-desc{font-size:.82rem;color:var(--text-mid);line-height:1.55;font-weight:500}
.tips-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.tip-box{background:var(--gold-bg);border:1.5px solid var(--gold-border);border-radius:14px;padding:12px 14px}
.tip-icon{font-size:1.1rem;margin-bottom:4px}
.tip-title{font-family:'Baloo 2',cursive;font-size:.88rem;font-weight:800;color:#7a5000;margin-bottom:4px}
.tip-desc{font-size:.8rem;color:#5a3800;font-weight:600;line-height:1.5}
/* users demo */
.users-demo{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-top:4px}
.user-card{border-radius:16px;padding:14px;border:2px solid var(--pink-mid);background:var(--pink-bg);text-align:center}
.user-avatar{font-size:2rem;margin-bottom:6px}
.user-name{font-family:'Baloo 2',cursive;font-size:.92rem;font-weight:800;color:var(--pink-deep)}
.user-age{font-size:.76rem;color:var(--text-light);font-weight:600;margin-bottom:8px}
.user-status{display:inline-block;padding:4px 12px;border-radius:50px;font-size:.75rem;font-weight:700}
.status-in{background:var(--green-bg);border:1px solid var(--green-border);color:#1a6640}
.status-out{background:#fff0f0;border:1px solid #fcc;color:#a04040}
.completion-banner{background:linear-gradient(135deg,var(--gold-bg),#fff5d0);border:2px solid var(--gold-border);border-radius:20px;padding:28px 22px;text-align:center;margin-bottom:22px;animation:fadeUp .5s ease .7s both}
.cb-icon{font-size:3rem;margin-bottom:10px}
.cb-title{font-family:'Baloo 2',cursive;font-size:1.4rem;font-weight:800;color:#7a5000;margin-bottom:8px}
.cb-text{font-size:.9rem;color:#5a3800;font-weight:600;line-height:1.65}
.nav-footer{max-width:760px;margin:0 auto;padding:0 22px 50px;display:flex;justify-content:space-between;align-items:center;position:relative;z-index:1;flex-wrap:wrap;gap:12px}
.btn-nav{display:flex;align-items:center;gap:7px;padding:11px 22px;border-radius:50px;font-family:'Quicksand',sans-serif;font-size:.88rem;font-weight:700;text-decoration:none;border:1.5px solid var(--pink-mid);background:var(--white);color:var(--text-mid);transition:all .2s;box-shadow:0 3px 10px var(--shadow)}
.btn-nav:hover{background:var(--pink-light)}
.btn-nav.primary{background:linear-gradient(135deg,var(--gold),#e09000);border-color:transparent;color:var(--white)}
.btn-nav.primary:hover{opacity:.88}
@media(max-width:580px){.tips-grid{grid-template-columns:1fr}.users-demo{grid-template-columns:1fr}.wrap{padding:10px 14px 60px}.nav-footer{padding:0 14px 40px}}
</style>
</head>
