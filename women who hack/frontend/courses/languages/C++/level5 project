      <div class="code-block"><span class="kw">#include</span> <span class="str">&lt;iostream&gt;</span>
<span class="kw">using namespace</span> std;

<span class="cmt">// פונקציה שמחשבת ממוצע</span>
<span class="tp">double</span> <span class="fn">average</span>(<span class="tp">int</span> arr[], <span class="tp">int</span> size) {
    <span class="tp">int</span> sum = 0;
    <span class="kw">for</span> (<span class="tp">int</span> i = 0; i &lt; size; i++)
        sum += arr[i];
    <span class="kw">return</span> (<span class="tp">double</span>)sum / size;
}

<span class="cmt">// פונקציה שמעדכנת ציון</span>
<span class="tp">void</span> <span class="fn">updateScore</span>(<span class="tp">int</span> arr[], <span class="tp">int</span> index, <span class="tp">int</span> newScore) {
    arr[index] = newScore;
}

<span class="tp">int</span> <span class="fn">main</span>() {
    <span class="tp">int</span> scores[3] = {80, 90, 70};

    cout &lt;&lt; <span class="str">"ממוצע לפני עדכון: "</span> &lt;&lt; <span class="fn">average</span>(scores, 3) &lt;&lt; endl;

    <span class="fn">updateScore</span>(scores, 1, 95);  <span class="cmt">// עדכון ציון שני ל-95</span>

    cout &lt;&lt; <span class="str">"ציונים אחרי עדכון: "</span>;
    <span class="kw">for</span> (<span class="tp">int</span> i = 0; i &lt; 3; i++)
        cout &lt;&lt; scores[i] &lt;&lt; <span class="str">" "</span>;

    cout &lt;&lt; endl;
    cout &lt;&lt; <span class="str">"ממוצע אחרי עדכון: "</span> &lt;&lt; <span class="fn">average</span>(scores, 3) &lt;&lt; endl;

    <span class="kw">return</span> 0;
}</div>
