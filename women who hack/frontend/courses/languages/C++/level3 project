.out-prompt{color:#ffb6d9}.out-input{color:#7ee8c0}.out-text{color:#f8d6e8}.out-special{color:#ffd68a}
.solution-toggle{width:100%;background:linear-gradient(135deg,var(--pink-dark),var(--pink-deep));color:var(--white);border:none;border-radius:14px;padding:14px 20px;font-family:'Quicksand',sans-serif;font-size:.92rem;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:10px;transition:opacity .2s;margin-bottom:0}
.solution-toggle:hover{opacity:.88}
.solution-toggle .toggle-icon{font-size:1.1rem;transition:transform .3s}
.solution-toggle.open .toggle-icon{transform:rotate(180deg)}
.solution-body{display:none;padding-top:16px}
.solution-body.show{display:block}
.code-block{background:#2d1b26;border-radius:14px;padding:16px 18px;font-family:'Courier New',monospace;font-size:.82rem;line-height:1.9;color:#f8d6e8;overflow-x:auto;direction:ltr;text-align:left}
.kw{color:#ffb6d9}.fn{color:#7ee8c0}.str{color:#ffd68a}.cmt{color:#7a5070;font-style:italic}.tp{color:#b8f0c8}
.section-label{font-family:'Baloo 2',cursive;font-size:.82rem;font-weight:800;color:var(--pink-deep);text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px;margin-top:16px}
.section-label:first-child{margin-top:0}
.explain-list{list-style:none;display:flex;flex-direction:column;gap:8px;margin-top:6px}
.explain-list li{display:flex;align-items:flex-start;gap:10px;font-size:.88rem;color:var(--text-mid);font-weight:600;line-height:1.55}
.explain-list li .edot{color:var(--pink-dark);font-size:1rem;flex-shrink:0}
.checklist{list-style:none;display:flex;flex-direction:column;gap:8px}
.check-item{display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:12px;background:var(--green-bg);border:1.5px solid var(--green-border);font-size:.88rem;font-weight:600;color:#1a5c38;cursor:pointer;user-select:none;transition:opacity .2s}
.check-item.unchecked{background:var(--pink-bg);border-color:#ffd6ec;color:var(--text-mid)}
.check-item .chk{width:22px;height:22px;border-radius:6px;border:2px solid var(--green-border);background:var(--green);color:white;display:flex;align-items:center;justify-content:center;font-size:.75rem;flex-shrink:0;transition:all .2s}
.check-item.unchecked .chk{background:var(--white);border-color:var(--pink-mid);color:transparent}
.complete-card{background:linear-gradient(135deg,var(--pink-deep),#c0397a);border-radius:20px;padding:28px;text-align:center;animation:fadeUp .5s ease .45s both;box-shadow:0 10px 40px rgba(217,79,138,.35)}
.complete-card .cc-icon{font-size:3rem;margin-bottom:10px}
.complete-card h2{font-family:'Baloo 2',cursive;font-size:1.4rem;font-weight:800;color:var(--white);margin-bottom:8px}
.complete-card p{font-size:.9rem;color:rgba(255,255,255,.88);font-weight:600;line-height:1.6;max-width:480px;margin:0 auto 18px}
.badge-row{display:flex;justify-content:center;gap:12px;flex-wrap:wrap}
.badge{background:rgba(255,255,255,.2);color:var(--white);border:1.5px solid rgba(255,255,255,.4);border-radius:50px;padding:7px 18px;font-size:.82rem;font-weight:700;backdrop-filter:blur(4px)}
.nav-footer{max-width:760px;margin:0 auto;padding:0 22px 50px;display:flex;justify-content:space-between;align-items:center;position:relative;z-index:1;flex-wrap:wrap;gap:12px}
.btn-nav{display:flex;align-items:center;gap:7px;padding:11px 22px;border-radius:50px;font-family:'Quicksand',sans-serif;font-size:.88rem;font-weight:700;text-decoration:none;border:1.5px solid var(--pink-mid);background:var(--white);color:var(--text-mid);transition:all .2s;box-shadow:0 3px 10px var(--shadow)}
.btn-nav:hover{background:var(--pink-light)}
.btn-nav.primary{background:linear-gradient(135deg,var(--pink-dark),var(--pink-deep));border-color:transparent;color:var(--white)}
.btn-nav.primary:hover{opacity:.88}
@media(max-width:600px){.wrap{padding:10px 14px 60px}.nav-footer{padding:0 14px 40px}}
</style>
</head>
