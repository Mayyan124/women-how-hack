.fn-line{display:flex;align-items:center;gap:0;flex-wrap:wrap}
.fn-part{padding:2px 8px;border-radius:6px;font-size:.8rem;font-weight:700;display:inline-block}
.fp-ret{background:#b8f0c820;color:#b8f0c8;border:1px solid #b8f0c850}
.fp-name{background:#7ee8c020;color:#7ee8c0;border:1px solid #7ee8c050}
.fp-param{background:#ffb6d920;color:#ffb6d9;border:1px solid #ffb6d950}
