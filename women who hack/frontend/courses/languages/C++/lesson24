  <div class="card">
    <div class="card-head"><span class="head-icon">💻</span><h2>טיפול מסודר בשגיאות</h2></div>
    <div class="card-body">
      <div class="section-label">📝 הדרך המקצועית לעבוד עם קבצים</div>
      <div class="code-block"><span class="kw">#include</span> <span class="str">&lt;iostream&gt;</span>
<span class="kw">#include</span> <span class="str">&lt;fstream&gt;</span>
<span class="kw">#include</span> <span class="str">&lt;string&gt;</span>
<span class="kw">using namespace</span> std;

<span class="tp">int</span> <span class="fn">main</span>() {
    <span class="cmt">// נתיב יחסי — עובד בכל מערכת!</span>
    ifstream inFile(<span class="str">"data/users.txt"</span>);

    <span class="kw">if</span> (!inFile.<span class="fn">is_open</span>()) {
        cerr &lt;&lt; <span class="str">"❌ שגיאה: לא נמצא קובץ data/users.txt"</span> &lt;&lt; endl;
        cerr &lt;&lt; <span class="str">"וודאי שהתיקייה data/ קיימת!"</span> &lt;&lt; endl;
        <span class="kw">return</span> 1;
    }

    string line;
    <span class="tp">int</span> count = 0;

    <span class="kw">while</span> (<span class="fn">getline</span>(inFile, line)) {
        <span class="kw">if</span> (inFile.<span class="fn">fail</span>() && !inFile.<span class="fn">eof</span>()) {
            cerr &lt;&lt; <span class="str">"❌ שגיאת קריאה בשורה "</span> &lt;&lt; count &lt;&lt; endl;
            <span class="kw">break</span>;
        }
        cout &lt;&lt; line &lt;&lt; endl;
        count++;
    }

    cout &lt;&lt; <span class="str">"\n📊 סה\"כ "</span> &lt;&lt; count &lt;&lt; <span class="str">" שורות נקראו."</span> &lt;&lt; endl;
    inFile.<span class="fn">close</span>();
    <span class="kw">return</span> 0;
}</div>

      <div style="margin-top:14px">
      <div class="section-label">📝 כתיבה עם בדיקת הצלחה</div>
      <div class="code-block"><span class="cmt">// כתיבה + אימות שהכל עבר תקין</span>
ofstream outFile(<span class="str">"output/results.txt"</span>);
<span class="kw">if</span> (!outFile) { <span class="cmt">// קיצור ל-is_open()</span>
    cerr &lt;&lt; <span class="str">"❌ לא ניתן ליצור קובץ. האם תיקיית output/ קיימת?"</span>;
    <span class="kw">return</span> 1;
}
outFile &lt;&lt; <span class="str">"תוצאות:\n"</span>;
<span class="kw">if</span> (outFile.<span class="fn">fail</span>()) {
