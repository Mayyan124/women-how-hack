  <h1>Templates בסיסיים</h1>
  <p>פונקציה אחת לכל הסוגים — כתבי פחות, עשי יותר! 🧬✨</p>
  <div class="progress-wrap">
    <div class="prog-labels"><span>Level 9</span><span>שיעור 34 / 36</span></div>
    <div class="prog-bar"><div class="prog-fill" style="width:50%"></div></div>
  </div>
</div>
<div class="wrap">

  <div class="card">
    <div class="card-head"><span class="head-icon">🔄</span><h2>חזרה קצרה מהשיעור הקודם</h2></div>
    <div class="card-body">
      <div class="recap-box">בשיעור 33 למדנו <strong>static variables ו-static functions</strong> — כיצד ליצור משתנים ופונקציות שמשותפים לכל האובייקטים של קלאס. עכשיו נלמד <strong>Templates</strong> — כיצד לכתוב פונקציות שעובדות עם <em>כל</em> סוג נתונים! 🧬</div>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><span class="head-icon">🎯</span><h2>מטרות השיעור</h2></div>
    <div class="card-body">
      <ul class="goal-list">
        <li><span class="gdot"></span>להבין מה זה Template ולמה הוא מגמיש את הקוד</li>
        <li><span class="gdot"></span>לכתוב template functions שעובדות עם סוגים שונים</li>
        <li><span class="gdot"></span>לגלות כיצד המהדר מייצר קוד אוטומטית לכל סוג</li>
      </ul>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><span class="head-icon">🤔</span><h2>מה זה Template?</h2></div>
    <div class="card-body">
      <div class="example-box" style="margin-bottom:16px">
        <strong>👗 תבנית תפירה —</strong><br/>
        Template הוא כמו תבנית תפירה: אותו דפוס, אבל כל פעם עם בד אחר. פונקציה אחת שעובדת עם int, עם double, עם string — בלי לכתוב שלוש פונקציות נפרדות!
      </div>
      <div class="concepts-grid">
        <div class="concept-box"><div class="concept-term">template&lt;typename T&gt;</div><div class="concept-desc">הכרזה שT הוא סוג כלשהו — המהדר ימלא את הפרטים בזמן הקומפילציה.</div></div>
        <div class="concept-box"><div class="concept-term">typename T</div><div class="concept-desc">T הוא שם "מציין מקום" לסוג. ניתן לקרוא לו כל שם — T, Type, MyType וכו'.</div></div>
        <div class="concept-box"><div class="concept-term">Template Instantiation</div><div class="concept-desc">כשקוראים לפונקציה עם int — המהדר יוצר גרסת int. עם double — גרסת double.</div></div>
        <div class="concept-box"><div class="concept-term">Type Deduction</div><div class="concept-desc">המהדר מבין לבד מה T — לא צריך לציין! הוא מסיק מסוג הפרמטרים.</div></div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><span class="head-icon">🏗️</span><h2>מבנה Template Function — שורה שורה</h2></div>
    <div class="card-body">
      <div class="anatomy-box">
        <div class="anatomy-line">
          <div class="anatomy-code"><span style="color:#ffb6d9">template</span>&lt;<span style="color:#ffb6d9">typename</span> <span style="color:#b8f0c8">T</span>&gt;</div>
          <div class="anatomy-arrow">→</div>
          <div class="anatomy-explain">🏷️ הכרזת template — T הוא סוג גנרי</div>
        </div>
        <div class="anatomy-line">
          <div class="anatomy-code"><span style="color:#b8f0c8">T</span> <span style="color:#7ee8c0">maxValue</span>(<span style="color:#b8f0c8">T</span> a, <span style="color:#b8f0c8">T</span> b) {</div>
          <div class="anatomy-arrow">→</div>
          <div class="anatomy-explain">⚙️ T כסוג החזרה ופרמטרים</div>
        </div>
        <div class="anatomy-line">
          <div class="anatomy-code">&nbsp;&nbsp;<span style="color:#ffb6d9">return</span> (a &gt; b) ? a : b;</div>
          <div class="anatomy-arrow">→</div>
          <div class="anatomy-explain">🔄 גוף הפונקציה — עובד לכל T</div>
        </div>
        <div class="anatomy-line">
          <div class="anatomy-code">}</div>
          <div class="anatomy-arrow">→</div>
          <div class="anatomy-explain">🔒 סגירה</div>
        </div>
      </div>
      <br/>
      <div class="section-label">🎯 איך T הופך לסוג אמיתי?</div>
      <div class="types-row">
        <div class="type-chip"><div class="chip-type">maxValue(3, 7)</div><div class="chip-label">T = int</div></div>
        <div class="type-chip"><div class="chip-type">maxValue(2.5, 9.1)</div><div class="chip-label">T = double</div></div>
        <div class="type-chip"><div class="chip-type">maxValue("abc","xyz")</div><div class="chip-label">T = string</div></div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><span class="head-icon">💻</span><h2>דוגמת קוד — maxValue עם Template</h2></div>
    <div class="card-body">
      <div class="code-block"><span class="kw">#include</span> &lt;iostream&gt;
<span class="kw">#include</span> &lt;string&gt;
<span class="kw">using namespace</span> std;

<span class="cmt">// template function אחת — עובדת לכל סוג!</span>
<span class="kw">template</span>&lt;<span class="kw">typename</span> <span class="tp">T</span>&gt;
<span class="tp">T</span> <span class="fn">maxValue</span>(<span class="tp">T</span> a, <span class="tp">T</span> b) {
    <span class="kw">return</span> (a &gt; b) ? a : b;
}

<span class="kw">int</span> <span class="fn">main</span>() {
    <span class="cmt">// המהדר יוצר גרסת int</span>
    cout &lt;&lt; <span class="fn">maxValue</span>(3, 7) &lt;&lt; endl;         <span class="cmt">// 7</span>

    <span class="cmt">// המהדר יוצר גרסת double</span>
    cout &lt;&lt; <span class="fn">maxValue</span>(2.5, 9.1) &lt;&lt; endl;     <span class="cmt">// 9.1</span>

    <span class="cmt">// המהדר יוצר גרסת string</span>
    <span class="tp">string</span> s = <span class="fn">maxValue</span>(<span class="str">"apple"</span>, <span class="str">"mango"</span>);
    cout &lt;&lt; s &lt;&lt; endl;                         <span class="cmt">// mango</span>

    <span class="kw">return</span> 0;
}</div>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><span class="head-icon">🌸</span><h2>למה Templates כל כך שימושיים?</h2></div>
    <div class="card-body">
      <div class="example-box">
        <strong>🚫 בלי template — קוד כפול:</strong><br/>
        int maxInt(int a, int b) {...}<br/>
        double maxDouble(double a, double b) {...}<br/>
        string maxString(string a, string b) {...}<br/><br/>
        <strong>✅ עם template — קוד אחד:</strong><br/>
        template&lt;typename T&gt;<br/>
        T maxValue(T a, T b) {...} &nbsp;← <strong>עובד לכולם!</strong>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><span class="head-icon">✏️</span><h2>תרגול</h2></div>
    <div class="card-body">
      <ol class="ex-list">
        <li>כתבי template function בשם <strong style="color:var(--pink-deep)">minValue(T a, T b)</strong> שמחזירה את הקטן מבין שניים</li>
        <li>קראי לה עם int (5, 3), עם double (7.2, 2.8) ועם string ("banana", "apple")</li>
        <li>הדפיסי את כל התוצאות ובדקי שהן נכונות</li>
      </ol>
    </div>
  </div>

  <div class="quiz-card">
    <div class="quiz-head"><span style="font-size:1.2rem">🧠</span><h2>מבחן — שיעור 34</h2></div>
    <div class="quiz-body">

      <div class="q-block" id="q1">
        <div class="q-num">שאלה 1 מתוך 3</div>
        <div class="q-text">template מאפשר לנו:</div>
        <div class="options">
          <div class="opt" onclick="answer('q1','A','A')"><span class="opt-letter">A</span>לכתוב פונקציה אחת שעובדת עם סוגים שונים</div>
          <div class="opt" onclick="answer('q1','B','A')"><span class="opt-letter">B</span>לכתוב פונקציות למספרים בלבד</div>
          <div class="opt" onclick="answer('q1','C','A')"><span class="opt-letter">C</span>למחוק אוטומטית משתנים מהזיכרון</div>
        </div>
        <div class="feedback fb-correct" id="q1-ok">✅ נכון! template מאפשר גנריות — פונקציה אחת לכל הסוגים! 🎉</div>
        <div class="feedback fb-wrong" id="q1-no">❌ template מאפשר לכתוב פונקציה כללית אחת שעובדת עם int, double, string ועוד!</div>
      </div>

      <hr class="q-divider"/>

      <div class="q-block" id="q2">
        <div class="q-num">שאלה 2 מתוך 3</div>
        <div class="q-text">מה יודפס כשקוראים ל-<span style="font-family:monospace;color:var(--pink-deep)">maxValue(4, 9)</span>?</div>
        <div class="q-code"><span style="color:#ffb6d9">template</span>&lt;<span style="color:#ffb6d9">typename</span> <span style="color:#b8f0c8">T</span>&gt;
<span style="color:#b8f0c8">T</span> <span style="color:#7ee8c0">maxValue</span>(<span style="color:#b8f0c8">T</span> a, <span style="color:#b8f0c8">T</span> b) {
    <span style="color:#ffb6d9">return</span> (a &gt; b) ? a : b;
}</div>
        <div class="options">
          <div class="opt" onclick="answer('q2','A','C')"><span class="opt-letter">A</span>4</div>
          <div class="opt" onclick="answer('q2','B','C')"><span class="opt-letter">B</span>13</div>
          <div class="opt" onclick="answer('q2','C','C')"><span class="opt-letter">C</span>9</div>
        </div>
        <div class="feedback fb-correct" id="q2-ok">✅ מדויק! 9 &gt; 4, אז הפונקציה מחזירה 9 🩷</div>
        <div class="feedback fb-wrong" id="q2-no">❌ הפונקציה בודקת מי גדול יותר ומחזירה אותו. 9 &gt; 4, אז התשובה היא 9.</div>
      </div>

      <hr class="q-divider"/>

      <div class="q-block" id="q3">
        <div class="q-num">שאלה 3 מתוך 3</div>
        <div class="q-text">מה T מייצג ב-<span style="font-family:monospace;color:var(--pink-deep)">template&lt;typename T&gt;</span>?</div>
        <div class="options">
          <div class="opt" onclick="answer('q3','A','B')"><span class="opt-letter">A</span>T זה תמיד int</div>
          <div class="opt" onclick="answer('q3','B','B')"><span class="opt-letter">B</span>T הוא "מציין מקום" לסוג כלשהו — המהדר ממלא לפי הקריאה</div>
          <div class="opt" onclick="answer('q3','C','B')"><span class="opt-letter">C</span>T זה שם של משתנה</div>
        </div>
        <div class="feedback fb-correct" id="q3-ok">✅ כל הכבוד! T הוא פרמטר-סוג — המהדר מחליף אותו בסוג האמיתי בזמן קומפילציה 🎉</div>
        <div class="feedback fb-wrong" id="q3-no">❌ T הוא פרמטר גנרי — לא int ולא שם משתנה. המהדר מבין מה T לפי הסוג שמועבר בקריאה.</div>
      </div>

      <div class="score-box" id="score-box">
        <div class="score-num" id="score-num"></div>
        <div class="score-msg" id="score-msg"></div>
      </div>
    </div>
  </div>

</div>
<div class="nav-footer">
  <a href="level9-lesson33.html" class="btn-nav">← שיעור 33</a>
  <a href="level9-lesson35.html" class="btn-nav primary">שיעור 35 — Template עם מחלקות ←</a>
</div>
<script>
const correct={q1:'A',q2:'C',q3:'B'};const answered={};const total=Object.keys(correct).length;
function answer(qId,chosen,correctAns){
  if(answered[qId])return;answered[qId]=chosen;
  const block=document.getElementById(qId);
  block.querySelectorAll('.opt').forEach((o,i)=>{const l=['A','B','C'][i];o.classList.add('locked');if(l===correctAns)o.classList.add('correct');else if(l===chosen&&chosen!==correctAns)o.classList.add('wrong');});
  document.getElementById(qId+(chosen===correctAns?'-ok':'-no')).classList.add('show');
  if(Object.keys(answered).length===total){
    let score=Object.keys(answered).filter(q=>answered[q]===correct[q]).length;
    document.getElementById('score-num').textContent=score+' / '+total;
    document.getElementById('score-msg').textContent=['נסי שוב! 💪','כמעט! 🌸','יפה מאוד! 💕','מושלם! ממשיכות לשיעור 35! 🎉'][score];
    document.getElementById('score-box').classList.add('show');
  }
}
</script>
