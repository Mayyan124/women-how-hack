    <div class="card-body">
      <table class="compare-table">
        <thead>
          <tr><th>מאפיין</th><th><span class="badge-trunc">ofstream (ברירת מחדל)</span></th><th><span class="badge-app">ios::app</span></th></tr>
        </thead>
        <tbody>
          <tr><td>מה קורה לתוכן קיים?</td><td>נמחק! ⚠️</td><td>נשמר ✅</td></tr>
          <tr><td>היכן הסמן מתחיל?</td><td>תחילת הקובץ</td><td>סוף הקובץ</td></tr>
          <tr><td>שימוש מתאים</td><td>דוח / קובץ חדש</td><td>יומן / לוג</td></tr>
          <tr><td>דוגמה לשימוש</td><td>שמירת הגדרות</td><td>רישום כניסות</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><span class="head-icon">💻</span><h2>קוד — פתיחה במצב Append</h2></div>
    <div class="card-body">
      <div class="section-label">📝 כתיבה רגילה — מוחקת תוכן קיים!</div>
      <div class="code-block"><span class="cmt">// ⚠️ כתיבה רגילה — מוחקת כל מה שהיה!</span>
ofstream myFile(<span class="str">"log.txt"</span>);
myFile &lt;&lt; <span class="str">"שורה ראשונה\n"</span>;
myFile.<span class="fn">close</span>(); <span class="cmt">// תוכן קודם נמחק!</span></div>

      <div style="margin-top:14px">
      <div class="section-label">✅ כתיבה במצב Append — שומרת תוכן קיים!</div>
      <div class="code-block"><span class="kw">#include</span> <span class="str">&lt;iostream&gt;</span>
<span class="kw">#include</span> <span class="str">&lt;fstream&gt;</span>
<span class="kw">#include</span> <span class="str">&lt;string&gt;</span>
<span class="kw">using namespace</span> std;

<span class="tp">int</span> <span class="fn">main</span>() {
    <span class="cmt">// ios::app = פתח בסוף הקובץ, אל תמחק!</span>
    ofstream logFile(<span class="str">"log.txt"</span>, ios::app);

    <span class="kw">if</span> (!logFile.<span class="fn">is_open</span>()) {
        cout &lt;&lt; <span class="str">"שגיאה בפתיחת הקובץ ❌"</span> &lt;&lt; endl;
        <span class="kw">return</span> 1;
    }

    string username;
    cout &lt;&lt; <span class="str">"שם משתמשת: "</span>;
    cin &gt;&gt; username;

    logFile &lt;&lt; username &lt;&lt; <span class="str">" נכנסה למערכת\n"</span>;
    cout &lt;&lt; <span class="str">"✅ נרשם בהצלחה!"</span> &lt;&lt; endl;

    logFile.<span class="fn">close</span>();
    <span class="kw">return</span> 0;
}</div>
      </div>
    </div>
  </div>

  <div class="card">
