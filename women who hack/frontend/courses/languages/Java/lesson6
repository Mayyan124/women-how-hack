</div>
<script>
    document.getElementById('hamburger').onclick = function() { document.getElementById('nav-links').classList.toggle('open'); };
    document.querySelectorAll('.lesson-nav a').forEach(link => {
        link.addEventListener('click', function(e) {
            e.preventDefault();
            document.querySelectorAll('.lesson-nav a').forEach(l => l.classList.remove('active'));
            this.classList.add('active');
            const t = document.querySelector(this.getAttribute('href'));
            if (t) t.scrollIntoView({ behavior: 'smooth' });
        });
    });
    const defaults = [
`// לולאת while — הדפסת מספרים
let i = 1;
while(i <= 5){
    console.log(i);
    i++;
}`,
`// הדפסת שלום 3 פעמים
let count = 0;
while(count < 3){
    console.log('שלום!');
    count++;
}`,
`// חשבי סכום 1-10
let sum = 0;
let i = 1;
while(i <= 10){
    sum += i;
    i++;
}
console.log('סכום:', sum);`
];
    function switchChallenge(idx) {
        document.querySelectorAll('.challenge-tab').forEach((t,i) => t.classList.toggle('active', i===idx));
        document.querySelectorAll('.challenge-panel').forEach((p,i) => p.classList.toggle('active', i===idx));
    }
    function runCode(idx) {
        const code = document.getElementById('editor-' + idx).value;
        const outputEl = document.getElementById('output-lines-' + idx);
        const lines = []; let count = 0;
        const fakeConsole = { log: (...args) => { if (++count > 200) return; lines.push(args.map(String).join(' ')); } };
        try {
            new Function('console', code)(fakeConsole);
            if (count > 200) { outputEl.innerHTML = '<div class="output-error">⚠️ לולאה ארוכה מדי — בדקי תנאי עצירה</div>'; return; }
            outputEl.innerHTML = lines.length ? lines.map(l => `<div class="output-line">${esc(l)}</div>`).join('') : '<span style="color:#666">// אין פלט</span>';
            checkBadge(idx, lines.join('\n'));
        } catch(e) { outputEl.innerHTML = `<div class="output-error">❌ ${esc(e.message)}</div>`; }
    }
    function resetCode(idx) {
        document.getElementById('editor-' + idx).value = defaults[idx];
        document.getElementById('output-lines-' + idx).innerHTML = '<span style="color:#555;font-size:0.85rem;">הפלט יופיע כאן...</span>';
        const b = document.getElementById('badge-' + idx); if (b) b.style.display = 'none';
    }
    function esc(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
    const badgeChecks = ['1', 'שלום', '55'];
    function checkBadge(idx, out) {
        const check = badgeChecks[idx];
        if (!check) return;
        const badge = document.getElementById('badge-' + idx);
        if (out.includes(check)) badge.style.display = 'block';
    }
    const answers = {"q1": "B", "q2": "B", "q3": "A", "q4": "A", "q5": "B"};
    function showScore() {
        let score = 0;
        for (let q in answers) {
            const chosen = document.querySelector(`input[name="${q}"]:checked`);
            document.querySelectorAll(`input[name="${q}"]`).forEach(o => {
                const lbl = o.parentElement;
                if (o.value === answers[q]) lbl.classList.add('correct');
                else if (chosen && o.value === chosen.value) lbl.classList.add('wrong');
                o.disabled = true;
            });
            if (chosen && chosen.value === answers[q]) score++;
        }
        const el = document.getElementById('score');
        el.style.display = 'block';
        el.innerHTML = `קיבלת ${score}/5 ✨ — ${['נסי שוב 💪','ממשיכים!','לא רע!','כמעט!','מושלם! 🌟','מצוין! 🏆'][score]}`;
    }
</script>
</body>
