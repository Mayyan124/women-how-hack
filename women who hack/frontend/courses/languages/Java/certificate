        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
        import { getAuth, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";

        const app = initializeApp({
            apiKey:"AIzaSyC-k44JqPI_wYvUwwqDsq4mdB1HAinJE4o",
            authDomain:"women-who-hack-40840.firebaseapp.com",
            projectId:"women-who-hack-40840",
            storageBucket:"women-who-hack-40840.firebasestorage.app",
            messagingSenderId:"180448551855",
            appId:"1:180448551855:web:5a05c8deb44fcc2f7f055a"
        });
        const auth = getAuth(app);

        const letters = [
            `יש רגעים בחיים שלא תמיד מבינים את המשמעות שלהם בזמן אמת אבל הם נשארים איתנו הרבה אחרי. והרגע הזה, שבו סיימת את הקורס, הוא בדיוק כזה.\n\nלאורך הדרך ראיתי אותך מתמודדת עם דברים שלא תמיד היו פשוטים — רגעים של בלבול, של חיפוש, של ניסיון להבין עד הסוף. ובכל פעם מחדש בחרת להמשיך. גם כשזה דרש ממך סבלנות, גם כשזה דרש ממך אמונה בעצמך.\n\nיש בך משהו מאוד מיוחד — משהו שקט אבל עוצמתי. יכולת להתקדם בקצב שלך בלי לוותר לעצמך באמת.\n\nאני רוצה שתזכרי את התחושה הזאת — את הרגע שבו הצלחת — ותיקחי אותו איתך לכל דבר שתעשי.\n\nאני גאה בך מכל הלב 💙\nמעיין`,
            `יש משהו בדרך שלך שפשוט אי אפשר לפספס — הנחישות שלך, הרצון להבין באמת ולא רק לעבור הלאה, והיכולת להישאר גם כשקשה.\n\nלא כל אחד בוחר להיכנס לעולם כזה. עולם שדורש חשיבה אחרת, סבלנות והתמודדות עם תסכולים. אבל את בחרת ולא רק שבחרת, אלא גם המשכת עד הסוף.\n\nאת יוצאת מהקורס הזה עם הרבה יותר ממידע. את יוצאת עם ביטחון, עם יכולת, עם הבנה עמוקה של עצמך.\n\nאני מאמינה בך באמת, ומחכה לראות לאן תגיעי 💙\nמעיין`,
            `לפעמים התהליך עצמו הוא הדבר הכי חשוב לא התוצאה הסופית, אלא הדרך שעברת כדי להגיע אליה.\n\nכשאני חושבת עלייך ועל הדרך שלך בקורס, אני רואה מישהי שלא פחדה לנסות — גם כשלא הכל היה ברור, גם כשזה דרש ממנה לעצור, לחשוב, ולהתחיל מחדש.\n\nיש בך סקרנות אמיתית, רצון להבין לעומק ולא להסתפק בתשובות קלות. וזה משהו נדיר.\n\nזה תהליך שלא נגמר כאן — זה רק הצעד הראשון בדרך הרבה יותר גדולה. המשיכי לשמור על הסקרנות, האומץ והרצון ללמוד.\n\nגאה בך מאוד 💙\nמעיין`,
            `יש אנשים שרואים קושי ועוצרים — ויש אנשים שרואים קושי ומחליטים להמשיך למרות הכל. ואת בדיוק מהסוג השני.\n\nלאורך הקורס ראיתי אותך מתקדמת גם ברגעים שלא היו פשוטים — רגעים של ספק, של חוסר ביטחון — ועדיין בחרת לא לוותר.\n\nהדרך שלך לא הייתה רק על קוד. היא הייתה על התמודדות, על גדילה ועל אמונה בעצמך. וזה נראה בכל שלב.\n\nאני רוצה שתיקחי את התחושה הזאת איתך — ותזכרי שגם בהמשך הדרך יהיו אתגרים, אבל יש בך את כל מה שצריך כדי לעבור אותם.\n\nאני גאה בך מאוד 💙\nמעיין`,
            `כשמסתכלים אחורה על הדרך שעברת בקורס, אפשר לראות שינוי אמיתי לא רק בידע שלך, אלא גם בגישה שלך לעצמך.\n\nבהתחלה אולי הדברים הרגישו מורכבים, אולי לא הכל היה ברור. אבל עם הזמן התחלת להבין יותר, להתחבר יותר, ולהרגיש בנוח.\n\nיש בך יכולת להמשיך גם כשלא מושלם, גם כשצריך להשקיע עוד קצת — וזה מה שעושה את ההבדל.\n\nהקורס הזה הוא רק התחלה, אבל הוא כבר מראה מי את ומה את יכולה להיות. יש לך הרבה מה לתת לעולם הזה.\n\nאוהבת וגאה בך 💙\nמעיין`
        ];

        onAuthStateChanged(auth, (user) => {
            if (!user) { window.location.href = '/login'; return; }

            const name = user.displayName || user.email.split('@')[0];
            const date = new Date().toLocaleDateString('he-IL', {year:'numeric', month:'long', day:'numeric'});

            let h = 0;
            for (const c of user.uid) h = Math.imul(31, h) + c.charCodeAt(0) | 0;
            const letterIdx = Math.abs(h) % letters.length;
            const certId = 'WWH-JAVA-' + Math.abs(h).toString(36).toUpperCase().slice(0, 8);

            document.getElementById('letter-name').textContent = name;
            document.getElementById('letter-body').textContent = letters[letterIdx];
            document.getElementById('cert-name').textContent   = name;
            document.getElementById('cert-date').textContent   = date;
            document.getElementById('cert-id').textContent     = certId;

            window._certData = { name, date, certId };

            document.getElementById('loading').style.display = 'none';
            document.getElementById('page').style.display    = 'flex';
            setTimeout(() => document.getElementById('page').classList.add('visible'), 50);
        });
    </script>

