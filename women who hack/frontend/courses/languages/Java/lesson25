        <pre><code>import java.util.*;
import java.io.*;

class User {
    private String name; private int age; private boolean active;
    public User(String n, int a, boolean act) throws Exception {
        if(a < 0) throw new Exception("גיל לא חוקי!");
        name=n; age=a; active=act;
    }
    public String getName()    { return name;   }
    public int    getAge()     { return age;    }
    public boolean isActive()  { return active; }
    public void printProfile() {
        System.out.println(name+", גיל:"+age+", פעילה:"+active);
    }
}

class UserManager {
    private ArrayList<User> users = new ArrayList<>();
    public void addUser(User u)        { users.add(u); }
    public void removeUser(String name){
        users.removeIf(u -> u.getName().equals(name));
    }
    public void showUsers()            { for(User u:users) u.printProfile(); }
    public ArrayList<User> getUsers()  { return users; }
}

public class MainApp {
    public static void main(String[] args){
        UserManager mgr = new UserManager();
        Scanner sc = new Scanner(System.in);
        boolean run = true;
        while(run){
            System.out.println("1-הוסף  2-הסר  3-הצג  4-יציאה");
            int ch = sc.nextInt(); sc.nextLine();
            switch(ch){
                case 1:
                    try{
                        System.out.print("שם: "); String name=sc.nextLine();
                        System.out.print("גיל: "); int age=sc.nextInt();
                        System.out.print("פעילה (true/false): "); boolean act=sc.nextBoolean(); sc.nextLine();
                        mgr.addUser(new User(name,age,act));
                    } catch(Exception e){ System.out.println("שגיאה: "+e.getMessage()); }
                    break;
                case 2:
                    System.out.print("שם להסרה: "); mgr.removeUser(sc.nextLine()); break;
                case 3: mgr.showUsers(); break;
                case 4: run=false; break;
            }
        }
        sc.close();
    }
}</code></pre>
