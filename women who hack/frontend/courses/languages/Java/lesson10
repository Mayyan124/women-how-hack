        <pre><code>import java.util.Scanner;
public class Community {
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        String[] names  = new String[3];
        int[]    ages   = new int[3];
        boolean[] active = new boolean[3];

        for(int i=0; i<3; i++){
            System.out.print("שם משתמשה " + (i+1) + ": ");
            names[i]  = sc.nextLine();
            System.out.print("גיל: ");
            ages[i]   = sc.nextInt();
            System.out.print("פעילה? (true/false): ");
            active[i] = sc.nextBoolean();
            sc.nextLine(); // ניקוי buffer
        }

        System.out.println("\n--- פרופיל משתמשות ---");
        for(int i=0; i<3; i++){
            System.out.println(names[i] + ", גיל: " + ages[i]
                             + ", פעילה: " + active[i]);
        }
    }
}</code></pre>
