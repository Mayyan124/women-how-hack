<script>
    const answers={"q1": "B", "q2": "D", "q3": "B", "q4": "C", "q5": "C", "q6": "C", "q7": "C", "q8": "B", "q9": "C", "q10": "C", "q11": "B", "q12": "C", "q13": "B", "q14": "B", "q15": "B", "q16": "C", "q17": "B", "q18": "B", "q19": "C", "q20": "B"};
    function showScore(){
        let s=0;
        for(let q in answers){
            const chosen=document.querySelector(`input[name="${q}"]:checked`);
            document.querySelectorAll(`input[name="${q}"]`).forEach(o=>{
                const l=o.parentElement;
                if(o.value===answers[q]) l.classList.add('correct');
                else if(chosen&&o.value===chosen.value) l.classList.add('wrong');
                o.disabled=true;
            });
            if(chosen&&chosen.value===answers[q]) s++;
        }
        const el=document.getElementById('score');
        el.style.display='block';
        const grade=Math.round(s/20*100);
        const msg=s>=18?'מצוין! 🏆':s>=15?'כל הכבוד! 🌟':s>=10?'טוב, ממשיכים! 💪':'נסי שוב 📖';
        el.innerHTML=`קיבלת ${s}/20 (${grade}) — ${msg}`;
        if(s>=10){
            document.getElementById('submit').scrollIntoView({behavior:'smooth'});
        }
    }
</script>
