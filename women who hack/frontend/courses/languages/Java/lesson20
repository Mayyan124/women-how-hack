        <pre><code>class User {
    private String name;
    private int age;

    User(String name, int age){
        this.name = name; this.age = age;
    }
    public String getName(){ return name; }
    public int    getAge() { return age;  }
    public void setName(String name){ this.name = name; }
    public void setAge(int age)     { this.age  = age;  }

    void printProfile(){
        System.out.println(name + ", גיל: " + age);
    }
    static void welcome(){
        System.out.println("ברוכות הבאות לקהילה!");
    }
}

class Admin extends User {
    Admin(String name, int age){ super(name, age); }
    void showRole(){ System.out.println(getName() + " — מנהלת 👑"); }
}

class PremiumUser extends User {
    PremiumUser(String name, int age){ super(name, age); }
    void showRole(){ System.out.println(getName() + " — פרימיום ⭐"); }
}

public class CommunityApp {
    public static void main(String[] args){
        User.welcome();
        User u        = new User("מיה", 18);
        Admin a       = new Admin("אנה", 25);
        PremiumUser p = new PremiumUser("שרה", 22);

        u.printProfile();
        a.showRole();
        p.showRole();
    }
}</code></pre>
