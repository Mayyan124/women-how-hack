        <div class="code-box">
            <div class="code-label">C# — Prime Numbers</div>
            <pre><span class="code-comment">// מציאת כל הראשוניים עד 20</span>
<span class="code-keyword">for</span>(<span class="code-keyword">int</span> n = 2; n <= 20; n++)
{
    <span class="code-keyword">bool</span> isPrime = <span class="code-keyword">true</span>;

    <span class="code-keyword">for</span>(<span class="code-keyword">int</span> i = 2; i < n; i++)
    {
        <span class="code-keyword">if</span>(n % i == 0)
        {
            isPrime = <span class="code-keyword">false</span>;
            <span class="code-keyword">break</span>;
        }
    }

    <span class="code-keyword">if</span>(isPrime)
        Console.Write(n + <span class="code-string">" "</span>);
}

<span class="code-comment">// פלט:</span>
<span class="code-output">2 3 5 7 11 13 17 19</span></pre>
