            <pre><span class="code-keyword">using</span> System;
<span class="code-keyword">using</span> System.Collections.Generic;
<span class="code-keyword">using</span> System.IO;

<span class="code-keyword">class</span> Student
{
    <span class="code-keyword">private string</span> name;
    <span class="code-keyword">private int</span> grade;

    <span class="code-keyword">public</span> Student(<span class="code-keyword">string</span> n, <span class="code-keyword">int</span> g) { name = n; grade = g; }
    <span class="code-keyword">public string</span> GetName() { <span class="code-keyword">return</span> name; }
    <span class="code-keyword">public int</span> GetGrade() { <span class="code-keyword">return</span> grade; }
    <span class="code-keyword">public string</span> GetInfo() { <span class="code-keyword">return</span> name + <span class="code-string">": "</span> + grade; }
}

<span class="code-keyword">class</span> Program
{
    <span class="code-keyword">static void</span> Main()
    {
        List<Student> students = <span class="code-keyword">new</span> List<Student>();

        <span class="code-comment">// הוספת תלמידות</span>
        students.Add(<span class="code-keyword">new</span> Student(<span class="code-string">"Maayan"</span>, 95));
        students.Add(<span class="code-keyword">new</span> Student(<span class="code-string">"Dana"</span>, 88));
        students.Add(<span class="code-keyword">new</span> Student(<span class="code-string">"Noa"</span>, 76));
        students.Add(<span class="code-keyword">new</span> Student(<span class="code-string">"Yael"</span>, 91));

        <span class="code-comment">// הצגת כל התלמידות</span>
        Console.WriteLine(<span class="code-string">"=== תלמידות ==="</span>);
        <span class="code-keyword">foreach</span>(Student s <span class="code-keyword">in</span> students)
            Console.WriteLine(s.GetInfo());

        <span class="code-comment">// סטטיסטיקות</span>
        <span class="code-keyword">int</span> sum = 0, max = students[0].GetGrade(), min = students[0].GetGrade();
        <span class="code-keyword">foreach</span>(Student s <span class="code-keyword">in</span> students)
        {
            sum += s.GetGrade();
            <span class="code-keyword">if</span>(s.GetGrade() > max) max = s.GetGrade();
            <span class="code-keyword">if</span>(s.GetGrade() < min) min = s.GetGrade();
        }
        <span class="code-keyword">double</span> avg = (<span class="code-keyword">double</span>)sum / students.Count;

        Console.WriteLine(<span class="code-string">"\n=== סטטיסטיקות ==="</span>);
        Console.WriteLine(<span class="code-string">"ממוצע: "</span> + avg);
        Console.WriteLine(<span class="code-string">"מקסימום: "</span> + max);
        Console.WriteLine(<span class="code-string">"מינימום: "</span> + min);

        <span class="code-comment">// חיפוש תלמידה</span>
        Console.Write(<span class="code-string">"\nחפשי תלמידה: "</span>);
        <span class="code-keyword">string</span> search = Console.ReadLine();
        <span class="code-keyword">bool</span> found = <span class="code-keyword">false</span>;
        <span class="code-keyword">foreach</span>(Student s <span class="code-keyword">in</span> students)
        {
            <span class="code-keyword">if</span>(s.GetName() == search)
            {
                Console.WriteLine(<span class="code-string">"נמצאה: "</span> + s.GetInfo());
                found = <span class="code-keyword">true</span>;
                <span class="code-keyword">break</span>;
            }
        }
        <span class="code-keyword">if</span>(!found) Console.WriteLine(<span class="code-string">"לא נמצאה"</span>);

        <span class="code-comment">// שמירה לקובץ עם try-catch</span>
        <span class="code-keyword">try</span>
        {
            <span class="code-keyword">string</span> data = <span class="code-string">""</span>;
            <span class="code-keyword">foreach</span>(Student s <span class="code-keyword">in</span> students)
                data += s.GetInfo() + <span class="code-string">"\n"</span>;
            data += <span class="code-string">"\nממוצע: "</span> + avg;
            File.WriteAllText(<span class="code-string">"students.txt"</span>, data);
            Console.WriteLine(<span class="code-string">"\nנשמר ב-students.txt!"</span>);
        }
        <span class="code-keyword">catch</span>(Exception e)
        {
            Console.WriteLine(<span class="code-string">"שגיאה בשמירה: "</span> + e.Message);
        }
    }
}

