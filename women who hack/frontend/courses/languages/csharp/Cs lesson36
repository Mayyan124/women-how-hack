        <div class="code-box">
            <div class="code-label">C# — Most Frequent Element</div>
            <pre><span class="code-keyword">int</span>[] nums = {1, 5, 7, 1, 3, 5, 1};
Dictionary<<span class="code-keyword">int</span>, <span class="code-keyword">int</span>> freq =
    <span class="code-keyword">new</span> Dictionary<<span class="code-keyword">int</span>, <span class="code-keyword">int</span>>();

<span class="code-comment">// ספירת כל מספר</span>
<span class="code-keyword">foreach</span>(<span class="code-keyword">int</span> n <span class="code-keyword">in</span> nums)
{
    <span class="code-keyword">if</span>(freq.ContainsKey(n))
        freq[n]++;
    <span class="code-keyword">else</span>
        freq[n] = 1;
}

<span class="code-comment">// מציאת הנפוץ ביותר</span>
<span class="code-keyword">int</span> maxCount = 0;
<span class="code-keyword">int</span> result = -1;

<span class="code-keyword">foreach</span>(<span class="code-keyword">int</span> key <span class="code-keyword">in</span> freq.Keys)
{
    <span class="code-keyword">if</span>(freq[key] > maxCount)
    {
        maxCount = freq[key];
        result = key;
    }
}

Console.WriteLine(<span class="code-string">"הנפוץ ביותר: "</span> + result);
Console.WriteLine(<span class="code-string">"כמות: "</span> + maxCount);

<span class="code-comment">// פלט:</span>
<span class="code-output">הנפוץ ביותר: 1
כמות: 3</span></pre>
