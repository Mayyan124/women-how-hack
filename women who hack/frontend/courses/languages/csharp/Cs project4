            <li><div class="req-num">2</div><span>Dictionary לשמירת ציון לכל תלמיד</span></li>
            <li><div class="req-num">3</div><span>הוספת 3 תלמידים וציונים</span></li>
            <li><div class="req-num">4</div><span>חישוב וממוצע הציונים</span></li>
            <li><div class="req-num">5</div><span>חיפוש תלמיד לפי שם</span></li>
        </ul>
    </div>
    <div class="section-card">
        <h2>💡 הסבר — איך לבצע</h2>
        <p>
        <strong>שלב 1:</strong> צרי List&lt;string&gt; לשמות ו-Dictionary&lt;string, int&gt; לציונים.<br><br>
        <strong>שלב 2:</strong> הוסיפי 3 תלמידים עם Add() ושמרי ציון לכל אחד ב-Dictionary.<br><br>
        <strong>שלב 3:</strong> חשבי ממוצע — סכום כל הציונים חלקי מספר התלמידים.<br><br>
        <strong>שלב 4:</strong> חיפוש — קבלי שם מהמשתמשת ובדקי עם ContainsKey().
        </p>
    </div>
    <div class="section-card">
        <h2>🔑 קוד הפתרון</h2>
        <div class="code-box">
            <div class="code-label">C# — Student Manager</div>
            <pre><span class="code-keyword">using</span> System;
<span class="code-keyword">using</span> System.Collections.Generic;

<span class="code-keyword">class</span> Program
{
    <span class="code-keyword">static void</span> Main()
    {
        List&lt;<span class="code-keyword">string</span>&gt; students = <span class="code-keyword">new</span> List&lt;<span class="code-keyword">string</span>&gt;();
        Dictionary&lt;<span class="code-keyword">string</span>, <span class="code-keyword">int</span>&gt; grades = <span class="code-keyword">new</span> Dictionary&lt;<span class="code-keyword">string</span>, <span class="code-keyword">int</span>&gt;();

        <span class="code-comment">// הוספת תלמידים</span>
        students.Add(<span class="code-string">"Maayan"</span>); grades[<span class="code-string">"Maayan"</span>] = 95;
        students.Add(<span class="code-string">"Dana"</span>);   grades[<span class="code-string">"Dana"</span>]   = 82;
        students.Add(<span class="code-string">"Noa"</span>);    grades[<span class="code-string">"Noa"</span>]    = 88;

        <span class="code-comment">// הדפסת כל התלמידים</span>
        Console.WriteLine(<span class="code-string">"--- תלמידים וציונים ---"</span>);
        <span class="code-keyword">foreach</span>(<span class="code-keyword">string</span> s <span class="code-keyword">in</span> students)
            Console.WriteLine(s + <span class="code-string">": "</span> + grades[s]);

        <span class="code-comment">// חישוב ממוצע</span>
        <span class="code-keyword">int</span> sum = 0;
        <span class="code-keyword">foreach</span>(<span class="code-keyword">string</span> s <span class="code-keyword">in</span> students)
            sum += grades[s];
        <span class="code-keyword">double</span> avg = (<span class="code-keyword">double</span>)sum / students.Count;
        Console.WriteLine(<span class="code-string">"ממוצע: "</span> + avg);

        <span class="code-comment">// חיפוש תלמיד</span>
        Console.WriteLine(<span class="code-string">"חפשי תלמיד:"</span>);
        <span class="code-keyword">string</span> search = Console.ReadLine();
        <span class="code-keyword">if</span>(grades.ContainsKey(search))
            Console.WriteLine(search + <span class="code-string">": "</span> + grades[search]);
        <span class="code-keyword">else</span>
            Console.WriteLine(<span class="code-string">"לא נמצא"</span>);
    }
}

