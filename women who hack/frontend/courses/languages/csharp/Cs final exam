        opts: ["להתחיל לכתוב מיד", "לחשוב על הפתרון — אלגוריתם ותכנון", "לבדוק Stack Overflow", "לכתוב הכי מהר"],
        correct: 1,
        fb_ok: "מתכנת טוב חושב לפני שכותב! 🧠",
        fb_no: "תמיד לתכנן ולחשוב על הפתרון לפני כתיבת קוד."
    }
];

let bowsEarned = 0;
let answeredCount = 0;
const totalQ = questions.length;

function buildQuestions(){
    const container = document.getElementById('questions-container');
    questions.forEach((q,idx) => {
        const div = document.createElement('div');
        div.className = 'quiz-q';
        div.id = 'q-'+idx;

        let codeHtml = q.code ? `<div class="code-snippet">${q.code.replace(/</g,'&lt;').replace(/>/g,'&gt;')}</div>` : '';

        let optsHtml = q.opts.map((opt,i) => `
            <button class="quiz-btn" onclick="answer(${idx},${i})" id="btn-${idx}-${i}">
                <span class="opt-letter">${['A','B','C','D'][i]}</span>
                ${opt}
            </button>`).join('');

        div.innerHTML = `
            <div class="q-header">
                <div class="q-num">${q.num}</div>
                <div class="q-text">
                    <span style="font-size:0.75rem;color:#7EC8E3;font-weight:600;">${q.level} — ${q.topic}</span><br>
                    ${q.q}
                </div>
            </div>
            ${codeHtml}
            <div class="quiz-options">${optsHtml}</div>
            <div class="quiz-feedback" id="fb-${idx}"></div>`;
        container.appendChild(div);
    });
}

function answer(qIdx, optIdx){
    const q = questions[qIdx];
    const btns = document.querySelectorAll(`[id^="btn-${qIdx}-"]`);
    btns.forEach(b => b.disabled = true);

    const correct = optIdx === q.correct;
    btns[optIdx].classList.add(correct ? 'correct' : 'wrong');
    if(!correct) btns[q.correct].classList.add('correct');

    const fb = document.getElementById('fb-'+qIdx);
    fb.textContent = correct ? '✅ ' + q.fb_ok : '❌ ' + q.fb_no;
    fb.className = 'quiz-feedback show ' + (correct ? 'ok' : 'no');

    const qDiv = document.getElementById('q-'+qIdx);
    qDiv.classList.add(correct ? 'answered-correct' : 'answered-wrong');

    if(correct){
        bowsEarned++;
        addBow();
    }

    answeredCount++;
    updateProgress();
}

function addBow(){
    const display = document.getElementById('bows-display');
    const bow = document.createElement('span');
    bow.className = 'bow-item';
    bow.textContent = '🎀';
    display.appendChild(bow);
    document.getElementById('bow-count').textContent = bowsEarned + ' / 20';
}

function updateProgress(){
    const pct = (answeredCount / totalQ) * 100;
    document.getElementById('progress-fill').style.width = pct + '%';
    document.getElementById('progress-text').textContent = answeredCount + ' מתוך ' + totalQ + ' שאלות נענו';
}

function showResults(){
    document.getElementById('submit-btn').disabled = true;
    const pct = Math.round((bowsEarned / totalQ) * 100);

    let emoji, msg, color;
    if(bowsEarned === 20){
        emoji = '🏆🎀✨';
        msg = 'מושלם! 20/20 — את C# Developer מושלמת! כל הכבוד על סיום הקורס המלא! 🎀🏆';
        color = '#FFD700';
        launchConfetti();
    } else if(bowsEarned >= 16){
        emoji = '🌟🎀';
        msg = 'מעולה! ציון גבוה מאוד — את כמעט מושלמת! חזרי על שאלות שפספסת.';
        color = '#7EC8E3';
    } else if(bowsEarned >= 12){
        emoji = '💪🎀';
        msg = 'יפה! ציון טוב. כדאי לחזור על הנושאים שבהם טעית.';
        color = '#A5D6A7';
    } else {
        emoji = '📚🎀';
        msg = 'חזרי על החומר וצרי שוב — את יכולה להצליח הרבה יותר!';
        color = '#CE93D8';
    }

    const bowsStr = '🎀'.repeat(bowsEarned);

    document.getElementById('results-score').innerHTML = `<span style="color:${color}">${bowsEarned}</span><span style="font-size:2rem;color:#aaa"> / 20</span>`;
    document.getElementById('results-bows').textContent = bowsStr;
    document.getElementById('results-msg').innerHTML = `<span style="font-size:1.5rem;">${emoji}</span><br><br>${msg}`;

    const results = document.getElementById('results');
    results.style.display = 'block';
    results.scrollIntoView({behavior:'smooth'});
}

function launchConfetti(){
    const colors = ['#FFD700','#FF69B4','#7EC8E3','#A5D6A7','#CE93D8','#FF8C00'];
    for(let i=0;i<80;i++){
        setTimeout(()=>{
            const c = document.createElement('div');
            c.className = 'confetti-piece';
            c.style.cssText = `
                left:${Math.random()*100}vw;
                background:${colors[Math.floor(Math.random()*colors.length)]};
                animation-duration:${Math.random()*2+2}s;
                animation-delay:${Math.random()*0.5}s;
                transform:rotate(${Math.random()*360}deg);
                width:${Math.random()*10+5}px;
                height:${Math.random()*10+5}px;
            `;
            document.body.appendChild(c);
            setTimeout(()=>c.remove(), 4000);
        }, i*50);
    }
}

buildQuestions();
</script>
</body>
</html>
