<span class="code-keyword">function</span> checkUser(user) {
    <span class="code-keyword">if</span>(user.age >= 18 && user.isLoggedIn) {
        <span class="code-keyword">return</span> <span class="code-string">"Access granted ✅"</span>;
    } <span class="code-keyword">else</span> {
        <span class="code-keyword">return</span> <span class="code-string">"Access denied ❌"</span>;
    }
}

<span class="code-comment">// מערך של משתמשים</span>
<span class="code-keyword">let</span> users = [
    {name: <span class="code-string">"Maayan"</span>, age: 18, isLoggedIn: <span class="code-keyword">true</span>},
    {name: <span class="code-string">"Dana"</span>,   age: 15, isLoggedIn: <span class="code-keyword">true</span>},
    {name: <span class="code-string">"Noa"</span>,    age: 22, isLoggedIn: <span class="code-keyword">false</span>}
];

<span class="code-comment">// לולאה על כל המשתמשים</span>
<span class="code-keyword">for</span>(<span class="code-keyword">let</span> i = 0; i < users.length; i++) {
    <span class="code-keyword">let</span> result = checkUser(users[i]);
    console.log(users[i].name + <span class="code-string">": "</span> + result);
}

<span class="code-comment">// פלט:</span>
