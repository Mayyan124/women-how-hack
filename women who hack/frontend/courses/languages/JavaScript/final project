            <pre><span class="code-comment">&lt;!-- HTML --&gt;</span>
&lt;input id="taskInput" placeholder="משימה חדשה..."&gt;
&lt;button id="addBtn"&gt;הוסף ✅&lt;/button&gt;
&lt;ul id="list"&gt;&lt;/ul&gt;

&lt;style&gt;
  .done {{ text-decoration: line-through; opacity: 0.5; }}
  li {{ cursor: pointer; padding: 8px; margin: 4px 0; background: #FFF8E1; border-radius: 8px; }}
&lt;/style&gt;

<span class="code-comment">// JavaScript</span>
<span class="code-keyword">let</span> input = document.getElementById(<span class="code-string">"taskInput"</span>);
<span class="code-keyword">let</span> button = document.getElementById(<span class="code-string">"addBtn"</span>);
<span class="code-keyword">let</span> list = document.getElementById(<span class="code-string">"list"</span>);

<span class="code-comment">// טעינת משימות שמורות</span>
<span class="code-keyword">let</span> tasks = JSON.parse(localStorage.getItem(<span class="code-string">"tasks"</span>)) || [];

<span class="code-keyword">function</span> render() {
    list.innerHTML = <span class="code-string">""</span>;
    tasks.forEach(<span class="code-keyword">function</span>(task, index) {
        <span class="code-keyword">let</span> li = document.createElement(<span class="code-string">"li"</span>);
        li.innerText = task.text;
        <span class="code-keyword">if</span>(task.done) li.classList.add(<span class="code-string">"done"</span>);

        <span class="code-comment">// סימון הושלם</span>
        li.addEventListener(<span class="code-string">"click"</span>, <span class="code-keyword">function</span>() {
            tasks[index].done = !tasks[index].done;
            save(); render();
        });

        <span class="code-comment">// מחיקה</span>
        <span class="code-keyword">let</span> del = document.createElement(<span class="code-string">"button"</span>);
        del.innerText = <span class="code-string">"🗑️"</span>;
        del.addEventListener(<span class="code-string">"click"</span>, <span class="code-keyword">function</span>(e) {
            e.stopPropagation();
            tasks.splice(index, 1);
            save(); render();
        });

        li.appendChild(del);
        list.appendChild(li);
    });
}

<span class="code-keyword">function</span> save() {
    localStorage.setItem(<span class="code-string">"tasks"</span>, JSON.stringify(tasks));
}

button.addEventListener(<span class="code-string">"click"</span>, <span class="code-keyword">function</span>() {
    <span class="code-keyword">if</span>(input.value === <span class="code-string">""</span>) <span class="code-keyword">return</span>;
    tasks.push({{text: input.value, done: <span class="code-keyword">false</span>}});
    save();
    render();
    input.value = <span class="code-string">""</span>;
});

render(); <span class="code-comment">// טעינה ראשונית</span></pre>
