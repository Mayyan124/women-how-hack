        <div class="results-score" id="results-score"></div>
        <div class="bows-final" id="results-bows"></div>
        <div class="results-msg" id="results-msg"></div>
        <a href="https://forms.gle/Asp1wQoTeaXoUsbZ8" target="_blank" class="cert-btn">הגישי את המבחן 🦋</a>
    </div>
</div>
<script>
document.getElementById('hamburger').onclick = function(){document.getElementById('nav-links').classList.toggle('open');};

const questions = [
    {num:1,level:"Level 1",q:"JavaScript אחראית על:",opts:["מבנה האתר","עיצוב","לוגיקה ואינטראקטיביות","צבעים"],correct:2,ok:"JS = לוגיקה. HTML = מבנה, CSS = עיצוב.",no:"JavaScript = לוגיקה ואינטראקטיביות."},
    {num:2,level:"Level 1",q:"מה ההבדל בין let ל-const?",opts:["אין הבדל","let ניתן לשינוי, const קבוע","const ניתן לשינוי","שניהם קבועים"],correct:1,ok:"let = ניתן לשינוי, const = קבוע.",no:"let ניתן לשינוי, const = ערך קבוע שלא ניתן לשנות."},
    {num:3,level:"Level 1",q:"מה הפלט?",code:"let x = 5;\nconsole.log(typeof x);",opts:["5","'number'","number","undefined"],correct:2,ok:"typeof 5 מחזיר 'number'.",no:"typeof על מספר מחזיר 'number'."},
    {num:4,level:"Level 1",q:"מה מחזיר 5 === '5'?",opts:["true","false","error","undefined"],correct:1,ok:"=== בודק סוג גם — 5 (number) !== '5' (string).",no:"=== בודק ערך וסוג. 5 הוא number, '5' הוא string → false."},
    {num:5,level:"Level 1",q:"מה הפלט?",code:"let age = 15;\nif(age >= 18) {\n  console.log('Adult');\n} else {\n  console.log('Minor');\n}",opts:["Adult","Minor","undefined","שגיאה"],correct:1,ok:"15 < 18 → else → Minor.",no:"15 לא >= 18, לכן else רץ → Minor."},
    {num:6,level:"Level 2",q:"כמה פעמים תרוץ הלולאה?",code:"for(let i = 0; i < 5; i++) { }",opts:["4","5","6","0"],correct:1,ok:"i = 0,1,2,3,4 — 5 פעמים.",no:"i רץ 0,1,2,3,4 — סה\"כ 5 פעמים."},
    {num:7,level:"Level 2",q:"מה return עושה בפונקציה?",opts:["מדפיס ערך","מחזיר ערך ועוצר הפונקציה","ממשיך לשורה הבאה","מוחק משתנה"],correct:1,ok:"return מחזיר ערך ועוצר את הפונקציה.",no:"return מחזיר ערך לקוד שקרא לפונקציה ועוצר אותה."},
    {num:8,level:"Level 2",q:"מה הפלט?",code:'let arr = ["a","b","c"];\nconsole.log(arr[1]);',opts:["a","b","c","undefined"],correct:1,ok:"אינדקס 1 = האיבר השני = 'b'.",no:"אינדקס מתחיל מ-0: arr[0]='a', arr[1]='b'."},
    {num:9,level:"Level 2",q:"איך ניגשים לשדה ב-Object?",code:'let user = {name: "Dana", age: 20};',opts:["user[name]","user.name","user->name","get(user,name)"],correct:1,ok:"user.name = גישה לשדה ב-Object.",no:"גישה ל-Object עם נקודה: user.name."},
    {num:10,level:"Level 2",q:"מה הפלט?",code:"let a = true;\nlet b = false;\nconsole.log(a && b);",opts:["true","false","error","undefined"],correct:1,ok:"true && false = false. AND דורש שניהם true.",no:"&& = AND. true && false = false."},
    {num:11,level:"Level 3",q:"addEventListener משמש ל:",opts:["חישוב","האזנה לאירועי משתמש","הדפסה","יצירת משתנה"],correct:1,ok:"addEventListener = האזנה לאירועים כמו click.",no:"addEventListener מוסיף מאזין לאירוע."},
    {num:12,level:"Level 3",q:"classList.toggle עושה:",opts:["רק מוסיף class","רק מסיר class","מוסיף אם אין, מסיר אם יש","בודק class"],correct:2,ok:"toggle = מתג — מוסיף/מסיר לפי מצב.",no:"toggle בודק אם ה-class קיים: אם כן מסיר, אם לא מוסיף."},
    {num:13,level:"Level 3",q:"מה עושה innerText?",opts:["משנה צבע","משנה תוכן הטקסט","מוסיף event","מוחק אלמנט"],correct:1,ok:"innerText משנה את הטקסט של האלמנט.",no:"element.innerText = 'text' משנה את הטקסט."},
    {num:14,level:"Level 4",q:"מה fetch מחזיר?",opts:["String","Object","Promise","Number"],correct:2,ok:"fetch מחזיר Promise — הבטחה לתשובה עתידית.",no:"fetch מחזיר Promise שמתקיים כשהתשובה מגיעה."},
    {num:15,level:"Level 4",q:"מה await עושה?",opts:["ממשיך מיד","מחכה לתוצאת Promise","מדפיס","מוחק"],correct:1,ok:"await עוצר ומחכה לתוצאה.",no:"await מחכה שה-Promise יסתיים לפני שממשיך."},
    {num:16,level:"Level 4",q:"מה response.json() עושה?",opts:["שולח נתונים","ממיר Response ל-Object","מוחק","מדפיס"],correct:1,ok:"response.json() ממירה את ה-Response ל-Object.",no:"response.json() מחזירה Promise שמכיל את ה-JSON כ-Object."},
    {num:17,level:"Level 4",q:"try/catch משמש ל:",opts:["לולאות","טיפול בשגיאות","משתנים","הדפסה"],correct:1,ok:"try/catch תופס שגיאות ומונע קריסה.",no:"try מנסה, catch תופס שגיאה אם קרתה."},
    {num:18,level:"Level 5",q:"localStorage.setItem עושה:",opts:["קורא נתון","שומר נתון","מוחק","מדפיס"],correct:1,ok:"setItem שומר נתון ב-Local Storage.",no:"localStorage.setItem('key', 'value') שומר זוג key-value."},
    {num:19,level:"Level 5",q:"למה JSON.stringify לפני שמירה ב-LocalStorage?",opts:["מהירות","כי LocalStorage שומר רק Strings","חובה","לא צריך"],correct:1,ok:"LocalStorage שומר רק Strings — חייבים להמיר.",no:"Local Storage מקבל רק Strings, לכן ממירים Object ל-String."},
    {num:20,level:"Level 5",q:"DRY אומר:",opts:["קוד קצר","אל תחזרי על קוד","קוד מהיר","קוד יפה"],correct:1,ok:"DRY = Don't Repeat Yourself.",no:"DRY = Don't Repeat Yourself — כתבי פונקציה במקום לחזור."}
];

let bowsEarned = 0, answeredCount = 0;

function buildQuestions(){
    const container = document.getElementById('questions-container');
    questions.forEach((q,idx) => {
        const div = document.createElement('div');
        div.className = 'quiz-q';
        div.id = 'q-'+idx;
        let codeHtml = q.code ? `<div class="code-snippet">${q.code.replace(/</g,'&lt;').replace(/>/g,'&gt;')}</div>` : '';
        let optsHtml = q.opts.map((opt,i) => `
            <button class="quiz-btn" onclick="answer(${idx},${i})" id="btn-${idx}-${i}">
                <span class="opt-letter">${['A','B','C','D'][i]}</span>${opt}
            </button>`).join('');
        div.innerHTML = `
            <div class="q-header">
                <div class="q-num">${q.num}</div>
                <div class="q-text">
                    <div class="q-level">${q.level}</div>${q.q}
                </div>
            </div>${codeHtml}
            <div class="quiz-options">${optsHtml}</div>
            <div class="quiz-feedback" id="fb-${idx}"></div>`;
        container.appendChild(div);
    });
}

function answer(qIdx, optIdx){
    const q = questions[qIdx];
    const btns = document.querySelectorAll(`[id^="btn-${qIdx}-"]`);
    btns.forEach(b => b.disabled = true);
    const correct = optIdx === q.correct;
    btns[optIdx].classList.add(correct ? 'correct' : 'wrong');
    if(!correct) btns[q.correct].classList.add('correct');
    const fb = document.getElementById('fb-'+qIdx);
    fb.textContent = correct ? '✅ ' + q.ok : '❌ ' + q.no;
    fb.className = 'quiz-feedback show ' + (correct ? 'ok' : 'no');
    document.getElementById('q-'+qIdx).classList.add(correct ? 'answered-correct' : 'answered-wrong');
    if(correct){ bowsEarned++; addBow(); }
    answeredCount++;
    updateProgress();
}

function addBow(){
    const display = document.getElementById('bows-display');
    const bow = document.createElement('span');
    bow.className = 'bow-item';
    bow.textContent = '🦋';
    display.appendChild(bow);
    document.getElementById('bow-count').textContent = bowsEarned + ' / 20';
}

function updateProgress(){
    const pct = (answeredCount / 20) * 100;
    document.getElementById('progress-fill').style.width = pct + '%';
    document.getElementById('progress-text').textContent = answeredCount + ' מתוך 20 שאלות נענו';
}

function showResults(){
    document.getElementById('submit-btn').disabled = true;
    let emoji, msg, color;
    if(bowsEarned === 20){ emoji='🏆🦋✨'; msg='מושלם! 20/20 — את JavaScript Developer מושלמת! 🦋🏆'; color='#FFD700'; launchConfetti(); }
    else if(bowsEarned >= 16){ emoji='🌟🦋'; msg='מעולה! ציון גבוה — חזרי על השאלות שפספסת.'; color='#F5A623'; }
    else if(bowsEarned >= 12){ emoji='💪🦋'; msg='יפה! חזרי על הנושאים שבהם טעית.'; color='#FFE082'; }
    else { emoji='📚🦋'; msg='חזרי על החומר ונסי שוב — את יכולה!'; color='#aaa'; }
    document.getElementById('results-score').innerHTML = `<span style="color:${color}">${bowsEarned}</span><span style="font-size:2rem;color:#aaa"> / 20</span>`;
    document.getElementById('results-bows').textContent = '🦋'.repeat(bowsEarned);
    document.getElementById('results-msg').innerHTML = `<span style="font-size:1.5rem;">${emoji}</span><br><br>${msg}`;
    const results = document.getElementById('results');
    results.style.display = 'block';
    results.scrollIntoView({behavior:'smooth'});
}

function launchConfetti(){
    const colors = ['#FFD700','#F5A623','#FF69B4','#7EC8E3','#a8ff78','#FF8C00'];
    for(let i=0;i<80;i++){
        setTimeout(()=>{
            const c = document.createElement('div');
            c.className = 'confetti-piece';
            c.style.cssText = `left:${Math.random()*100}vw;background:${colors[Math.floor(Math.random()*colors.length)]};animation-duration:${Math.random()*2+2}s;animation-delay:${Math.random()*0.5}s;width:${Math.random()*10+5}px;height:${Math.random()*10+5}px;`;
            document.body.appendChild(c);
            setTimeout(()=>c.remove(), 4000);
        }, i*50);
    }
}

buildQuestions();
</script>
