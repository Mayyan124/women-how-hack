            <pre><span class="code-comment">// קליטת גיל מהמשתמש</span>
<span class="code-keyword">let</span> input = prompt(<span class="code-string">"Enter your age:"</span>);
<span class="code-keyword">let</span> age = parseInt(input); <span class="code-comment">// המרה למספר</span>

<span class="code-comment">// ניתוח הגיל</span>
<span class="code-keyword">if</span>(age >= 18) {
    console.log(<span class="code-string">"You are an Adult ✅"</span>);
} <span class="code-keyword">else if</span>(age >= 13) {
    console.log(<span class="code-string">"You are a Teenager 🌱"</span>);
} <span class="code-keyword">else if</span>(age >= 0) {
    console.log(<span class="code-string">"You are a Child 👶"</span>);
} <span class="code-keyword">else</span> {
    console.log(<span class="code-string">"Invalid age ❌"</span>);
}

<span class="code-comment">// הרחבה — Senior</span>
<span class="code-keyword">if</span>(age >= 65) {
    console.log(<span class="code-string">"Senior citizen 🌟"</span>);
}

<span class="code-comment">// פלט לדוגמה (גיל 20):</span>
<span class="code-output">You are an Adult ✅</span></pre>
