        <div class="code-box">
            <div class="code-label">JavaScript — Advanced Logic</div>
            <pre><span class="code-keyword">let</span> age = 20;
<span class="code-keyword">let</span> hasLicense = <span class="code-keyword">true</span>;

<span class="code-comment">// AND - שניהם חייבים</span>
<span class="code-keyword">if</span>(age >= 18 && hasLicense) {
    console.log(<span class="code-string">"Can drive"</span>);
}

<span class="code-comment">// OR - מספיק אחד</span>
<span class="code-keyword">let</span> isVIP = <span class="code-keyword">false</span>;
<span class="code-keyword">let</span> isPremium = <span class="code-keyword">true</span>;
<span class="code-keyword">if</span>(isVIP || isPremium) {
    console.log(<span class="code-string">"Access granted"</span>);
}

<span class="code-comment">// NOT</span>
<span class="code-keyword">if</span>(!hasLicense) {
    console.log(<span class="code-string">"No license!"</span>);
}</pre>
        </div>
        <div class="thinking-box">
