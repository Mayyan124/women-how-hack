            <pre><span class="code-comment">&lt;!-- HTML --&gt;</span>
&lt;button id="btn"&gt;לחצי עליי!&lt;/button&gt;
&lt;p id="msg"&gt;&lt;/p&gt;

<span class="code-comment">// JavaScript</span>
<span class="code-keyword">let</span> button = document.getElementById(<span class="code-string">"btn"</span>);
<span class="code-keyword">let</span> msg = document.getElementById(<span class="code-string">"msg"</span>);

button.addEventListener(<span class="code-string">"click"</span>, <span class="code-keyword">function</span>() {
    msg.innerText = <span class="code-string">"לחצת! 🎀"</span>;
    console.log(<span class="code-string">"Clicked!"</span>);
});</pre>
